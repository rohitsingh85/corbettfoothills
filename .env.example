PUBLIC_GA4_DEBUG=

# Razorpay (set via Cloudflare Pages dashboard, not local env)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# InnPilot
BOOKING_API_KEY=
INNPILOT_BASE_URL=https://api.innpilot.com/v1
