---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../data/site.json";
---

<MainLayout>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <!-- ==================== HERO ==================== -->
  <section class="relative flex min-h-[90vh] items-center overflow-hidden bg-cfr-green-dark">
    <!-- Background layers -->
    <div class="absolute inset-0 bg-hero-pattern"></div>
    <div class="absolute inset-0 bg-leaf-pattern opacity-50"></div>

    <div class="relative mx-auto max-w-7xl px-4 pt-24 pb-16 sm:px-6 lg:px-8 lg:pt-32 lg:pb-24">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-sand-500/20 bg-white/5 px-4 py-1.5 text-xs font-medium uppercase tracking-widest text-sand-300 backdrop-blur-sm">
          <span class="flex h-2 w-2 rounded-full bg-sand-500 animate-pulse"></span>
          Jim Corbett National Park, Uttarakhand
        </div>

        <h1 class="mt-6 font-display text-5xl font-bold leading-tight text-white sm:text-6xl lg:text-7xl xl:text-8xl">
          {siteData.site.tagline.split('Meets')[0]}
          <span class="block italic text-sand-300">{siteData.hero.headingItalic}</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white sm:text-xl">
          {siteData.site.description}
        </p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-lg bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !px-8 !py-4 !text-base">
            Explore Stays
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="#experiences" class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-cfr-green-accent px-6 py-3 text-sm font-semibold text-cfr-green-accent transition-all duration-300 hover:bg-cfr-green-accent hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !border-sand-500 !px-8 !py-4 !text-base !text-sand-200 hover:!bg-sand-500/20">
            Virtual Tour
          </a>
        </div>

        <!-- Stats -->
        <div class="mt-16 grid grid-cols-3 gap-8 border-t border-white/10 pt-10">
          <div>
            <p class="font-display text-3xl font-bold text-white sm:text-4xl">6</p>
            <p class="mt-1 text-xs uppercase tracking-widest text-sand-300">Exclusive Suites</p>
          </div>
          <div>
            <p class="font-display text-3xl font-bold text-white sm:text-4xl">8 km</p>
            <p class="mt-1 text-xs uppercase tracking-widest text-sand-300">From Corbett Park</p>
          </div>
          <div>
            <p class="font-display text-3xl font-bold text-white sm:text-4xl">600+</p>
            <p class="mt-1 text-xs uppercase tracking-widest text-sand-300">Bird Species</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden sm:block">
      <div class="flex flex-col items-center gap-2 text-sand-300">
        <span class="text-xs uppercase tracking-widest">Scroll</span>
        <svg class="h-5 w-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </div>
    </div>
  </section>

  <!-- ==================== FEATURES ==================== -->
  <section class="bg-cream-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-cfr-green-accent">Why CFR</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-cfr-green-dark sm:text-4xl lg:text-5xl mt-3">Designed for the Wild at Heart</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-earth-600 mx-auto">
          Every element of Corbett Foothills Retreat is crafted to bring you closer to nature without compromising on comfort.
        </p>
      </div>

      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          siteData.features.map((feature) => (
            <div class="rounded-2xl bg-white/80 shadow-premium backdrop-blur-sm transition-all duration-300 hover:shadow-glow group relative overflow-hidden p-8">
              <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-xl bg-cfr-green-accent/10 text-cfr-green-accent transition-colors group-hover:bg-cfr-green-accent group-hover:text-white">
                {
                  feature.icon === "home" && (
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                    </svg>
                  )
                }
                {
                  feature.icon === "binoculars" && (
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                    </svg>
                  )
                }
                {
                  feature.icon === "leaf" && (
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                    </svg>
                  )
                }
                {
                  feature.icon === "heart" && (
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
                  )
                }
              </div>
              <h3 class="text-lg font-semibold text-cfr-green-dark">{feature.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-earth-600">{feature.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== ACCOMMODATION ==================== -->
  <section id="accommodation" class="bg-cfr-green-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-sand-300">Accommodation</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{siteData.accommodationIntro.heading}</h2>
        <p class="mt-4 text-lg text-white">{siteData.accommodationIntro.description}</p>
      </div>

      <!-- Highlights -->
      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          siteData.accommodationIntro.highlights.map((highlight) => (
            <div class="group rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm transition-all duration-500 hover:border-cfr-green-accent/30 hover:bg-white/10 hover:-translate-y-1">
              <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-cfr-green-accent/20 text-cfr-green-accent">
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                </svg>
              </div>
              <h3 class="mt-6 font-display text-xl font-bold text-white">{highlight}</h3>
            </div>
          ))
        }
      </div>

      <!-- Room Features -->
      <div class="mt-16">
        <h3 class="text-center font-display text-2xl font-bold text-white">Room Features</h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            siteData.roomFeatures.map((feature) => (
              <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-5 py-3">
                <svg class="h-5 w-5 shrink-0 text-cfr-green-leaf" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-sm text-white">{feature}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Who Stays With Us -->
      <div class="mt-16">
        <h3 class="text-center font-display text-2xl font-bold text-white">Who Stays With Us</h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            siteData.guestTypes.map((guest) => (
              <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-5 py-3">
                <svg class="h-5 w-5 shrink-0 text-cfr-green-leaf" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
                <span class="text-sm text-white">{guest}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Pet-friendly -->
      <div class="mt-16 flex flex-col items-center gap-4 rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-cfr-green-accent/20 text-cfr-green-accent">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>
        </div>
        <div>
          <h3 class="font-display text-xl font-bold text-white">Pet-Friendly Retreat</h3>
          <p class="mt-2 text-sm leading-relaxed text-white">We understand pets are family. Our pet-friendly environment allows you to enjoy your holiday without leaving your furry companions behind.</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <p class="text-lg leading-relaxed text-white max-w-3xl mx-auto">{siteData.accommodationCta}</p>
        <div class="mt-6">
          <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-cfr-green-accent px-6 py-3 text-sm font-semibold text-cfr-green-accent transition-all duration-300 hover:bg-cfr-green-accent hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !border-sand-500 !text-sand-200 hover:!bg-sand-500/20 !rounded-full !px-10 !py-4">
            View All Accommodations
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== GALLERY ==================== -->
  <section id="gallery" class="bg-cream-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-cfr-green-accent">Moments</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-cfr-green-dark sm:text-4xl lg:text-5xl mt-3">Life at the Retreat</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-earth-600 mx-auto">
          From misty jungle mornings to starlit dinners by the river — every moment at CFR is a memory in the making.
        </p>
      </div>

      <div class="mt-12 columns-1 gap-4 sm:columns-2 md:columns-3">
        {
          siteData.images.gallery.slice(0, 3).map((img, index) => (
            <div class="mb-4 break-inside-avoid overflow-hidden rounded-xl shadow-card transition-all duration-300 hover:shadow-glow">
              <img
                src={img}
                alt={`Corbett Foothills Retreat photo ${index + 1}`}
                class="w-full object-cover"
                loading="lazy"
              />
            </div>
          ))
        }
        {
          siteData.images.hero.slice(0, 2).map((img, index) => (
            <div class="mb-4 break-inside-avoid overflow-hidden rounded-xl shadow-card transition-all duration-300 hover:shadow-glow">
              <img
                src={img}
                alt={`Corbett Foothills Retreat scenery ${index + 1}`}
                class="w-full object-cover"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ==================== EXPERIENCES ==================== -->
  <section id="experiences" class="bg-cfr-green-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-sand-300">Experiences</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">Immersive Encounters</h2>
        <p class="mt-4 text-lg text-white">
          Beyond the retreat, the jungle beckons. Our curated experiences are led by expert naturalists and local guides.
        </p>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          siteData.experiences.map((exp) => {
            const getIcon = (title) => {
              if (title.includes('Safari')) return 'search';
              if (title.includes('Nature')) return 'leaf';
              if (title.includes('Bird')) return 'leaf';
              if (title.includes('Farming') || title.includes('Organic')) return 'leaf';
              if (title.includes('Bonfire')) return 'sparkles';
              return 'sun';
            };
            const icon = getIcon(exp.title);
            return (
              <div class="group rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm transition-all duration-500 hover:border-cfr-green-accent/30 hover:bg-white/10 hover:-translate-y-1">
                <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-cfr-green-accent/20 text-cfr-green-accent">
                  {icon === 'search' && (
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                    </svg>
                  )}
                  {icon === 'leaf' && (
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                    </svg>
                  )}
                  {icon === 'sparkles' && (
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
                    </svg>
                  )}
                  {icon === 'sun' && (
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                    </svg>
                  )}
                </div>
                <h3 class="mt-6 font-display text-xl font-bold text-white">{exp.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-white">{exp.description}</p>
                {exp.highlights && exp.highlights.length > 0 && (
                  <ul class="mt-4 space-y-2 text-sm text-white">
                    {exp.highlights.map((h) => (
                      <li class="flex items-center gap-2">
                        <svg class="h-4 w-4 shrink-0 text-cfr-green-leaf" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                        {h}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section class="bg-cream-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-cfr-green-accent">About</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-cfr-green-dark sm:text-4xl lg:text-5xl mt-3">{siteData.site.tagline}</h2>
      </div>

      <div class="mt-12 mx-auto max-w-4xl">
        <div class="rounded-2xl bg-white/80 shadow-premium backdrop-blur-sm transition-all duration-300 hover:shadow-glow relative p-8 md:p-12">
          <svg class="mb-6 h-10 w-10 text-cfr-green-accent/20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C9.591 11.69 11 13.167 11 15c0 1.933-1.567 3.5-3.5 3.5-1.271 0-2.402-.642-2.917-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C19.591 11.69 21 13.167 21 15c0 1.933-1.567 3.5-3.5 3.5-1.271 0-2.402-.642-2.917-1.179z" />
          </svg>
          <p class="text-base leading-relaxed text-earth-700 italic md:text-lg">&ldquo;{siteData.about.paragraphs[0]}&rdquo;</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CTA / CONTACT ==================== -->
  <section id="contact" class="relative overflow-hidden bg-cfr-green-dark py-20 sm:py-28">
    <div class="absolute inset-0 bg-leaf-pattern opacity-30"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="grid gap-12 lg:grid-cols-2">
          <!-- Left: info -->
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-sand-300">Reserve Your Stay</p>
            <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Begin Your Journey</h2>
            <p class="mt-4 text-lg text-white">
              Reach out to our concierge team. Whether you're planning a romantic getaway, a family adventure, or a solo retreat, we'll craft the perfect itinerary.
            </p>

            <div class="mt-8 space-y-4">
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cfr-green-accent/20">
                  <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-widest text-sand-300">Email</p>
                  <a href={`mailto:${siteData.site.email}`} class="text-sm font-medium text-sand-200 hover:text-white transition-colors">
                    {siteData.site.email}
                  </a>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cfr-green-accent/20">
                  <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-widest text-sand-300">Phone</p>
                  <a href={`tel:${siteData.site.phone}`} class="text-sm font-medium text-sand-200 hover:text-white transition-colors">
                    {siteData.site.phone}
                  </a>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cfr-green-accent/20">
                  <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-widest text-sand-300">Location</p>
                  <p class="text-sm font-medium text-sand-200">
                    {siteData.site.location}
                  </p>
                </div>
              </div>
              <a
                href={`https://wa.me/${siteData.site.whatsapp.replace(/[^0-9]/g, '')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-green-600 px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-green-700 hover:shadow-lg hover:-translate-y-0.5"
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
                Chat on WhatsApp
              </a>
            </div>
          </div>

          <!-- Right: form -->
          <div class="rounded-2xl bg-white/80 shadow-premium backdrop-blur-sm transition-all duration-300 hover:shadow-glow p-8">
            <form action="#" method="POST" class="space-y-5">
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="name" class="block text-sm font-medium text-earth-700">Full Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="mt-1 block w-full rounded-lg border-earth-200 bg-cream text-sm text-earth-800 placeholder:text-earth-400 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-earth-700">Email</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="mt-1 block w-full rounded-lg border-earth-200 bg-cream text-sm text-earth-800 placeholder:text-earth-400 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                    placeholder="you@example.com"
                  />
                </div>
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="checkin" class="block text-sm font-medium text-earth-700">Check-in</label>
                  <input
                    type="date"
                    id="checkin"
                    name="checkin"
                    class="mt-1 block w-full rounded-lg border-earth-200 bg-cream text-sm text-earth-800 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                  />
                </div>
                <div>
                  <label for="checkout" class="block text-sm font-medium text-earth-700">Check-out</label>
                  <input
                    type="date"
                    id="checkout"
                    name="checkout"
                    class="mt-1 block w-full rounded-lg border-earth-200 bg-cream text-sm text-earth-800 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                  />
                </div>
              </div>

              <div>
                <label for="guests" class="block text-sm font-medium text-earth-700">Guests</label>
                <select
                  id="guests"
                  name="guests"
                  class="mt-1 block w-full rounded-lg border-earth-200 bg-cream text-sm text-earth-800 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                >
                  <option>1 Adult</option>
                  <option>2 Adults</option>
                  <option>2 Adults + 1 Child</option>
                  <option>2 Adults + 2 Children</option>
                  <option>3+ Adults</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-earth-700">Special Requests</label>
                <textarea
                  id="message"
                  name="message"
                  rows={3}
                  class="mt-1 block w-full rounded-lg border-earth-200 bg-cream text-sm text-earth-800 placeholder:text-earth-400 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                  placeholder="Any preferences or questions..."
                ></textarea>
              </div>

              <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 w-full !rounded-lg !py-3.5">
                Send Enquiry
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                </svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>
