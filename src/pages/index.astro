---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../data/site.json";
---

<MainLayout>
  <Fragment slot="head">
    <link rel="preload" href="/images/hero-bg-design.webp" as="image" fetchpriority="high" />
  </Fragment>
  <Fragment slot="header">
    <Header variant="transparent" />
  </Fragment>

  <!-- ==================== HERO ==================== -->
  <section class="relative flex flex-col overflow-hidden bg-cfr-green-dark">
    <div class="relative w-full">
      <img
        src="/images/hero-bg-design.webp"
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
        fetchpriority="high"
        loading="eager"
      />
      <div class="absolute inset-0 bg-cfr-green-dark/30"></div>
      <div class="relative mx-auto max-w-7xl px-4 pt-56 pb-16 sm:px-6 lg:px-8 lg:pt-56 lg:pb-24">
        <div class="mx-auto max-w-3xl text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-cfr-sand-500/20 bg-white/5 px-4 py-1.5 text-xs font-medium uppercase tracking-widest text-cfr-sand-300 backdrop-blur-sm">
            <span class="flex h-2 w-2 rounded-full bg-cfr-sand-500 animate-pulse"></span>
            Jim Corbett National Park, Uttarakhand
          </div>

          <h1 class="mt-6 font-display text-4xl font-bold leading-tight text-white sm:text-5xl lg:text-7xl xl:text-8xl">
            {siteData.site.tagline.split('Meets')[0]}
            <span class="block italic text-cfr-sand-300">{siteData.hero.headingItalic}</span>
          </h1>

          <p class="mt-6 mx-auto max-w-xl text-lg leading-relaxed text-white sm:text-xl">
            {siteData.site.description}
          </p>
        </div>
      </div>
    </div>

    <!-- Buttons and stats outside the background image -->
    <div class="relative w-full bg-cfr-green-dark">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-lg bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !px-8 !py-4 !text-base">
              Explore Stays
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>

          </div>

          <div class="mt-12 flex flex-col items-center gap-0 border-t border-white/10 pt-10 md:grid md:grid-cols-3 md:gap-0 md:items-start">
            <div class="flex w-full flex-col items-center border-b border-white/10 py-6 last:border-b-0 md:border-b-0 md:py-0">
              <p class="font-display text-4xl font-bold text-white whitespace-nowrap md:text-5xl">6</p>
              <p class="mt-1 max-w-[180px] text-center text-sm uppercase tracking-widest text-cfr-sand-300">Exclusive Family Rooms</p>
            </div>
            <div class="flex w-full flex-col items-center border-b border-white/10 py-6 last:border-b-0 md:border-b-0 md:py-0">
              <p class="font-display text-4xl font-bold text-white whitespace-nowrap md:text-5xl">8 km</p>
              <p class="mt-1 max-w-[180px] text-center text-sm uppercase tracking-widest text-cfr-sand-300">From Jim Corbett Park Gate</p>
            </div>
            <div class="flex w-full flex-col items-center border-b border-white/10 py-6 last:border-b-0 md:border-b-0 md:py-0">
              <p class="font-display text-4xl font-bold text-white whitespace-nowrap md:text-5xl">50 Meters</p>
              <p class="mt-1 max-w-[180px] text-center text-sm uppercase tracking-widest text-cfr-sand-300">From Jim Corbett Forest</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FEATURES ==================== -->
  <section class="bg-cfr-cream-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-base font-semibold uppercase tracking-widest text-cfr-green-accent">Why Corbett Foothills Retreat</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-cfr-green-dark sm:text-4xl lg:text-5xl mt-3">Designed for the Wild at Heart</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-cfr-earth-600 mx-auto">
          Every element of Corbett Foothills Retreat is crafted to bring you closer to nature without compromising on comfort.
        </p>
      </div>

      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          siteData.features.map((feature) => (
            <div class="flex flex-col items-center rounded-2xl bg-white/80 shadow-premium backdrop-blur-sm transition-all duration-300 hover:shadow-glow group relative overflow-hidden p-8 text-center">
              <div class="flex h-48 w-48 items-center justify-center overflow-hidden rounded-3xl">
                {
                  feature.icon === "home" && (
                    <img src="/images/blog-boutique-hero.jpg" alt="Boutique Farmstay" class="h-full w-full object-cover" loading="lazy" />
                  )
                }
                {
                  feature.icon === "tree" && (
                    <img src="/images/nature-walks-1.jpg" alt="Nature Walks" class="h-full w-full object-cover" loading="lazy" />
                  )
                }
                {
                  feature.icon === "leaf" && (
                    <img src="/images/organic-farming-1.jpg" alt="Organic Farming" class="h-full w-full object-cover" loading="lazy" />
                  )
                }
                {
                  feature.icon === "heart" && (
                    <img src="/images/pet-friendly-1.webp" alt="Pet-Friendly" class="h-full w-full object-cover" loading="lazy" />
                  )
                }
              </div>
              <h3 class="mt-6 text-lg font-semibold text-cfr-green-dark">{feature.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-cfr-earth-600" set:html={feature.description}></p>
            </div>
          ))
        }
      </div>
      <div class="mt-12 text-center">
        <a href="/blogs" class="inline-flex items-center gap-2 text-sm font-semibold text-cfr-green-accent hover:text-cfr-green-dark transition-colors">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
          </svg>
          Read Our Travel Blog
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== ACCOMMODATION ==================== -->
  <section id="accommodation" class="bg-cfr-green-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-base font-semibold uppercase tracking-widest !text-cfr-sand-200">Accommodation</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">{siteData.accommodationIntro.heading}</h2>
        <p class="mt-4 text-lg text-white">{siteData.accommodationIntro.description}</p>
      </div>


      <!-- Room Features -->
      <div class="mt-16">
        <h3 class="text-center font-display text-2xl font-bold text-white">Room Features</h3>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            siteData.roomFeatures.map((feature) => (
              <div class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-5 py-3">
                <svg class="h-5 w-5 shrink-0 text-cfr-green-leaf" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-sm text-white">{feature}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Who Loves Our Retreat -->
      <div class="mt-16">
        <h3 class="text-center font-display text-2xl font-bold text-white">Who Loves Our Retreat</h3>
        <div class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            [
              "/images/safari-1.webp",
              "/images/family-1.jpg",
              "/images/couples-retreat.webp",
              "/images/bird-watching-1.jpg",
              "/images/remote-worker.jpg",
              "/images/nature-walks-2.jpg"
            ].map((imgSrc, i) => (
              <div class="flex flex-col items-center rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm text-center transition-all duration-500 hover:border-cfr-green-accent/30 hover:bg-white/10 hover:-translate-y-1">
                <div class="flex h-48 w-48 items-center justify-center overflow-hidden rounded-3xl">
                  <img src={imgSrc} alt={siteData.guestTypes[i]} class="h-full w-full object-cover" loading="lazy" />
                </div>
                <span class="mt-6 text-sm text-white">{siteData.guestTypes[i]}</span>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Pet-friendly -->
      <div class="mt-16 flex flex-col items-center gap-6 rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm text-center">
        <div class="flex h-48 w-48 items-center justify-center overflow-hidden rounded-3xl">
          <img src="/images/pet-friendly-tile.png" alt="Pet-Friendly Retreat" class="h-full w-full object-scale-down" loading="lazy" />
        </div>
        <div>
          <h3 class="font-display text-xl font-bold text-white">Pet-Friendly Retreat</h3>
          <p class="mt-2 text-sm leading-relaxed text-white">We understand pets are family. Our pet-friendly environment allows you to enjoy your holiday without leaving your furry companions behind.</p>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 text-center">
        <p class="text-lg leading-relaxed text-white max-w-3xl mx-auto">{siteData.accommodationCta}</p>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-cfr-green-accent px-6 py-3 text-sm font-semibold text-cfr-green-accent transition-all duration-300 hover:bg-cfr-green-accent hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !border-cfr-sand-500 !text-cfr-sand-200 hover:!bg-cfr-sand-500/20 !rounded-full !px-10 !py-4">
            View All Accommodations
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          <a href="/tariff" class="inline-flex items-center justify-center gap-2 rounded-full bg-cfr-green-accent px-10 py-4 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5">
            View Rates & Pricing
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== GALLERY ==================== -->
  <section id="gallery" class="bg-cfr-cream-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-base font-semibold uppercase tracking-widest text-cfr-green-accent">Moments</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-cfr-green-dark sm:text-4xl lg:text-5xl mt-3">Life at the Retreat</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-cfr-earth-600 mx-auto">
          From misty jungle mornings to starlit dinners under the clear skies — every moment at CFR is a memory in the making.
        </p>
      </div>

      <div class="mt-12 flex justify-center">
        {
          siteData.images.gallery.slice(0, 3).map((img, index) => (
            <div class="w-full max-w-4xl overflow-hidden rounded-xl shadow-card transition-all duration-300 hover:shadow-glow">
              <img
                src={img}
                alt={`Corbett Foothills Retreat photo ${index + 1}`}
                class="w-full aspect-[16/9] object-cover"
                loading="lazy"
              />
            </div>
          ))
        }
      </div>
      <div class="mt-8 text-center">
        <a href="/gallery" class="inline-flex items-center gap-2 text-sm font-semibold text-cfr-green-accent hover:text-cfr-green-dark transition-colors">
          View Full Gallery
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== EXPERIENCES ==================== -->
  <section id="experiences" class="bg-cfr-green-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <a href="/experiences" class="text-base font-semibold uppercase tracking-widest text-cfr-sand-300 hover:text-white transition-colors">Experiences</a>
        <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">Immersive Encounters</h2>
        <p class="mt-4 text-lg text-white">
          Beyond the retreat, the jungle beckons. Our curated experiences are led by expert naturalists and local guides.
        </p>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        {
          siteData.experiences.map((exp) => {
            const imgMap = {
              'Jungle Safari': 'Jungle Safari.jpeg',
              'Nature Walks': 'Nature Walks.webp',
              'Bird Watching': 'Bird Watching.jpeg',
              'Organic Farming Experience': 'Organic Farming.webp',
              'Bonfire Evenings': 'Bonfire Evenings.jpg',
              'Family Getaways': 'Family Getaways.jpeg',
              'Forest Stream Picnic': 'stream-picnic-1.webp',
              'Pet-Friendly Holidays': 'Pet-Friendly Holidays.webp',
              'Forest Mornings & Sunset Views': 'forest-mornings-sunset-views.webp',
              'Reconnect & Rejuvenate': 'reconnect-rejuvenate.webp'
            };
            const imgFile = imgMap[exp.title];
            return (
              <div class="group flex flex-col items-center rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm text-center transition-all duration-500 hover:border-cfr-green-accent/30 hover:bg-white/10 hover:-translate-y-1">
                <div class="flex h-48 w-48 items-center justify-center overflow-hidden rounded-3xl">
                  <img src={`/images/${encodeURIComponent(imgFile)}`} alt={exp.title} class="h-full w-full object-cover" loading="lazy" />
                </div>
                <h3 class="mt-6 font-display text-xl font-bold text-white">{exp.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-white">{exp.description}</p>
                {exp.highlights && exp.highlights.length > 0 && (
                  <ul class="mt-4 space-y-2 text-sm text-white">
                    {exp.highlights.map((h) => (
                      <li class="flex items-center gap-2">
                        <svg class="h-4 w-4 shrink-0 text-cfr-green-leaf" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                        {h}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ==================== ABOUT ==================== -->
  <section class="bg-cfr-cream-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <a href="/about-us" class="text-base font-semibold uppercase tracking-widest text-cfr-green-accent transition-colors hover:text-cfr-green-dark">About</a>
        <h2 class="font-display text-3xl font-bold tracking-tight text-cfr-green-dark sm:text-4xl lg:text-5xl mt-3">{siteData.site.tagline}</h2>
      </div>

      <div class="mt-12 mx-auto max-w-4xl">
        <div class="rounded-2xl bg-white/80 shadow-premium backdrop-blur-sm transition-all duration-300 hover:shadow-glow relative p-8 md:p-12">
          <svg class="mb-6 h-10 w-10 text-cfr-green-accent/20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C9.591 11.69 11 13.167 11 15c0 1.933-1.567 3.5-3.5 3.5-1.271 0-2.402-.642-2.917-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C19.591 11.69 21 13.167 21 15c0 1.933-1.567 3.5-3.5 3.5-1.271 0-2.402-.642-2.917-1.179z" />
          </svg>
          <p class="text-base leading-relaxed text-cfr-earth-700 italic md:text-lg">&ldquo;{siteData.about.paragraphs[0]}&rdquo;</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CTA / CONTACT ==================== -->
  <section id="contact" class="relative overflow-hidden bg-cfr-green-dark py-20 sm:py-28">
    <div class="absolute inset-0 bg-leaf-pattern opacity-30"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="grid gap-12 lg:grid-cols-2">
          <!-- Left: info -->
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-cfr-sand-300">Reserve Your Stay</p>
            <h2 class="mt-3 font-display text-3xl font-bold text-white sm:text-4xl">Begin Your Journey</h2>
            <p class="mt-4 text-lg text-white">
              Reach out to our concierge team. Whether you're planning a romantic getaway, a family adventure, or a solo retreat, we'll craft the perfect itinerary.
            </p>

            <div class="mt-8 space-y-4">
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cfr-green-accent/20">
                  <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-widest text-cfr-sand-300">Email</p>
                  <a href={`mailto:${siteData.site.email}`} class="text-sm font-medium text-cfr-sand-200 hover:text-white transition-colors">
                    {siteData.site.email}
                  </a>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cfr-green-accent/20">
                  <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-widest text-cfr-sand-300">Phone</p>
                  <a href={`tel:${siteData.site.phone}`} class="text-sm font-medium text-cfr-sand-200 hover:text-white transition-colors">
                    {siteData.site.phone}
                  </a>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-cfr-green-accent/20">
                  <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-widest text-cfr-sand-300">Location</p>
                  <p class="text-sm font-medium text-cfr-sand-200">
                    {siteData.site.location}
                  </p>
                </div>
              </div>
              <a
                href={`https://wa.me/${siteData.site.whatsapp.replace(/[^0-9]/g, '')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-green-600 px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-green-700 hover:shadow-lg hover:-translate-y-0.5"
              >
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
                Chat on WhatsApp
              </a>
            </div>
          </div>

          <!-- Right: form -->
          <div class="rounded-2xl bg-white/80 shadow-premium backdrop-blur-sm transition-all duration-300 hover:shadow-glow p-8">
            <form action="#" method="POST" class="space-y-5">
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="name" class="block text-sm font-medium text-cfr-earth-700">Full Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="mt-1 block w-full rounded-lg border-cfr-earth-200 bg-cream text-sm text-cfr-earth-800 placeholder:text-cfr-earth-400 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-cfr-earth-700">Email</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="mt-1 block w-full rounded-lg border-cfr-earth-200 bg-cream text-sm text-cfr-earth-800 placeholder:text-cfr-earth-400 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                    placeholder="you@example.com"
                  />
                </div>
              </div>

              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="checkin" class="block text-sm font-medium text-cfr-earth-700">Check-in</label>
                  <input
                    type="date"
                    id="checkin"
                    name="checkin"
                    class="mt-1 block w-full rounded-lg border-cfr-earth-200 bg-cream text-sm text-cfr-earth-800 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                  />
                </div>
                <div>
                  <label for="checkout" class="block text-sm font-medium text-cfr-earth-700">Check-out</label>
                  <input
                    type="date"
                    id="checkout"
                    name="checkout"
                    class="mt-1 block w-full rounded-lg border-cfr-earth-200 bg-cream text-sm text-cfr-earth-800 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                  />
                </div>
              </div>

              <div>
                <label for="guests" class="block text-sm font-medium text-cfr-earth-700">Guests</label>
                <select
                  id="guests"
                  name="guests"
                  class="mt-1 block w-full rounded-lg border-cfr-earth-200 bg-cream text-sm text-cfr-earth-800 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                >
                  <option>1 Adult</option>
                  <option>2 Adults</option>
                  <option>2 Adults + 1 Child</option>
                  <option>2 Adults + 2 Children</option>
                  <option>3+ Adults</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-cfr-earth-700">Special Requests</label>
                <textarea
                  id="message"
                  name="message"
                  rows={3}
                  class="mt-1 block w-full rounded-lg border-cfr-earth-200 bg-cream text-sm text-cfr-earth-800 placeholder:text-cfr-earth-400 focus:border-cfr-green-accent focus:ring-cfr-green-accent"
                  placeholder="Any preferences or questions..."
                ></textarea>
              </div>

              <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-lg bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 w-full !rounded-lg !py-3.5">
                Send Enquiry
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                </svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>
