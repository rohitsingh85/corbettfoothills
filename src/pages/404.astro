---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../data/site.json";
---

<MainLayout title="Page Not Found" description="The page you are looking for does not exist. Return to Corbett Foothills Retreat homepage." breadcrumbs={[{name: "404"}]}>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <section class="relative flex min-h-[60vh] items-center justify-center overflow-hidden pt-56">
    <div class="absolute inset-0 bg-cfr-green-dark"></div>
    <div class="absolute inset-0 bg-hero-pattern"></div>
    <div class="absolute inset-0 bg-leaf-pattern opacity-20"></div>
    <div class="relative z-10 mx-auto max-w-2xl px-4 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-8xl font-bold text-cfr-sand-500 sm:text-9xl">404</h1>
      <p class="mt-4 text-xl text-white sm:text-2xl">Page Not Found</p>
      <p class="mt-4 text-base leading-relaxed text-cfr-sand-300">
        The page you are looking for might have been moved, deleted, or never existed.
        Let us help you find your way back.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="inline-flex items-center justify-center gap-2 rounded-full bg-cfr-sand-500 px-8 py-4 text-sm font-semibold text-cfr-earth-700 shadow-md transition-all duration-300 hover:bg-cfr-sand-400 hover:-translate-y-0.5">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
          Back to Home
        </a>
        <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-cfr-sand-500 px-8 py-4 text-sm font-semibold text-cfr-sand-200 transition-all duration-300 hover:bg-cfr-sand-500/20">
          View Accommodation
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-cfr-sand-500 px-8 py-4 text-sm font-semibold text-cfr-sand-200 transition-all duration-300 hover:bg-cfr-sand-500/20">
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>
