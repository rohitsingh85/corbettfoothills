---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../data/site.json";

const suiteImages = [
  { src: "/images/luxury-room-style.webp", alt: "Forest View Suite with king bed and natural light at Corbett Foothills Retreat" },
  { src: siteData.images.accommodation[2], alt: "Premium room with peaceful forest views near Jim Corbett National Park" },
  { src: "/images/outside-shot.webp", alt: "Garden Room with spacious interiors at Corbett boutique farmstay" },
];

const farmImages = [
  { src: "/images/organic-farming-1.jpg", alt: "Organic vegetable garden at Corbett Foothills Retreat farmstay" },
  { src: "/images/organic-farming-2.jpg", alt: "Fresh organic herbs and seasonal vegetables grown at Corbett farm" },
  { src: "/images/organic-farming-3.jpg", alt: "Sustainable farming practices near Jim Corbett National Park" },
];

const diningImages = [
  { src: "/images/blog-boutique-img8.webp", alt: "Freshly prepared Kumaoni meal served at Corbett Foothills Retreat" },
  { src: "/images/blog-things-img30.webp", alt: "Traditional Jhangora Kheer dessert from Kumaon region" },
  { src: "/images/blog-things-img28.jpg", alt: "Aloo Ke Gutke traditional Kumaoni potato dish" },
];

const outdoorImages = [
  { src: "/images/bonfire-1.jpg", alt: "Bonfire evening under starlit skies at Corbett Foothills Retreat" },
  { src: "/images/blog-things-img11.jpg", alt: "Butterfly on wildflower along Corbett forest walk" },
  { src: "/images/live-1.webp", alt: "Corbett Foothills Retreat property surrounded by forest landscape" },
];

const experienceImages = [
  { src: "/images/safari-1.webp", alt: "Jeep safari on forest track in Jim Corbett National Park" },
  { src: "/images/nature-walks-1.webp", alt: "Guided nature walk through forest trails near Corbett" },
  { src: "/images/stream-picnic-1.webp", alt: "Forest stream picnic beside mountain stream in Corbett" },
];

const petImages = [
  { src: "/images/pet-friendly-1.jpg", alt: "Pet-friendly grounds at Corbett Foothills Retreat" },
  { src: "/images/pet-friendly-2.webp", alt: "Dogs enjoying open spaces at pet-friendly farmstay near Corbett" },
  { src: "/images/pet-friendly-3.webp", alt: "Nature surroundings at pet-friendly boutique retreat near Jim Corbett" },
];

const jungleImages = [
  { src: siteData.images.hero[0], alt: "Jim Corbett National Park forest landscape at dawn" },
  { src: siteData.images.hero[1], alt: "Wilderness view from Corbett Foothills Retreat property" },
  { src: "/images/live-50.webp", alt: "Scenic landscape of Corbett tiger reserve Uttarakhand" },
];

const gallerySections = [
  { id: "suites", title: "Our Suites", images: suiteImages },
  { id: "farm", title: "Organic Farm", images: farmImages },
  { id: "dining", title: "Dining", images: diningImages },
  { id: "outdoor", title: "Outdoor Spaces", images: outdoorImages },
  { id: "experiences", title: "Experiences", images: experienceImages },
  { id: "pets", title: "Pet-Friendly Stays", images: petImages },
  { id: "jungle", title: "Jungle Landscapes", images: jungleImages },
];
---

<MainLayout
  title="Gallery"
  description="Explore the photo gallery of Corbett Foothills Retreat — boutique suites, organic farm, Kumaoni dining, outdoor spaces, and wildlife experiences near Jim Corbett National Park."
  breadcrumbs={[{name: "Gallery"}]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "Photo Gallery — Corbett Foothills Retreat",
      description: "Explore the photo gallery of Corbett Foothills Retreat — boutique suites, organic farm, Kumaoni dining, outdoor spaces, and wildlife experiences near Jim Corbett National Park.",
      isPartOf: { "@type": "WebSite", name: "Corbett Foothills Retreat", url: "https://corbett.life" },
      mainEntity: {
        "@type": "ImageGallery",
        name: "Corbett Foothills Retreat Photo Gallery",
        image: gallerySections.flatMap((s) => s.images.map((i) => i.src)),
      },
    })} />
  </Fragment>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <section class="relative flex min-h-[40vh] items-end overflow-hidden pt-56">
    <div class="absolute inset-0 bg-cfr-green-dark"></div>
    <div class="absolute inset-0 bg-hero-pattern"></div>
    <div class="absolute inset-0 bg-leaf-pattern opacity-30"></div>
    <div class="relative z-10 w-full bg-cfr-green-dark">
      <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 lg:pb-16">
        <div class="max-w-3xl">
          <a href="/" class="mb-4 inline-flex items-center gap-1 text-xs uppercase tracking-widest text-cfr-sand-300 transition-colors hover:text-white">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back to Home
          </a>
          <h1 class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
            Gallery
          </h1>
          <p class="mt-4 max-w-xl text-lg text-white">
            A visual journey through Corbett Foothills Retreat — from our thoughtfully designed suites and organic farm to the wild beauty of the Corbett landscape.
          </p>
        </div>
      </div>
    </div>
  </section>

  {
    gallerySections.map((section) => (
      <section class="bg-cfr-cream-dark py-16 sm:py-20">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <h2 class="font-display text-3xl font-bold text-cfr-green-dark sm:text-4xl text-center">
            {section.title}
          </h2>
          <div class="mt-10 grid gap-4 sm:grid-cols-3">
            {section.images.map((img) => (
              <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-card transition-all duration-300 hover:shadow-glow">
                <img
                  src={img.src}
                  alt={img.alt}
                  class="h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="bg-cfr-green-dark py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
        Experience It Yourself
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white">
        Photos capture moments, but nothing compares to experiencing the forest waking up around you, the taste of farm-fresh Kumaoni cuisine, and the warmth of personalised hospitality.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-full bg-cfr-green-accent px-10 py-4 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2">
          View Accommodation
        </a>
        <a href="/tariff" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-cfr-green-accent px-10 py-4 text-sm font-semibold text-cfr-green-accent transition-all duration-300 hover:bg-cfr-green-accent hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !border-cfr-sand-500 !text-cfr-sand-200 hover:!bg-cfr-sand-500/20">
          View Rates & Pricing
        </a>
        <a href="/experiences" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-cfr-sand-500 px-10 py-4 text-sm font-semibold text-cfr-sand-200 transition-all duration-300 hover:bg-cfr-sand-500/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-sand-500 focus-visible:ring-offset-2">
          Explore Experiences
        </a>
        <a href="/booking/" class="inline-flex items-center justify-center gap-2 rounded-full bg-cfr-green-accent px-10 py-4 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2">
          Book Your Stay
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>