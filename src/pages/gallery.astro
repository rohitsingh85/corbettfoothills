---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../data/site.json";

const categoryImages = {
  jungle: siteData.galleryLayout.jungle,
  architecture: siteData.galleryLayout.architecture,
  avian: siteData.galleryLayout.avian,
};

const aspectVariants = [
  "aspect-[4/3]",
  "aspect-[1/1]",
  "aspect-[3/4]",
  "aspect-[16/9]",
  "aspect-[4/5]",
  "aspect-[3/2]",
  "aspect-[5/4]",
  "aspect-[9/16]",
  "aspect-[2/1]",
];
---

<MainLayout title="Gallery" description="Photo gallery of Corbett Foothills Retreat — boutique farmstay near Jim Corbett National Park — showcasing jungle landscapes, resort architecture, and avian life.">
  <Fragment slot="header">
    <Header />
  </Fragment>

  <section class="relative flex min-h-[40vh] items-end overflow-hidden bg-cfr-green-dark pt-24">
    <div class="absolute inset-0 bg-hero-pattern"></div>
    <div class="absolute inset-0 bg-leaf-pattern opacity-30"></div>
    <div class="relative mx-auto w-full max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 lg:pb-16">
      <div class="max-w-3xl">
        <a href="/" class="inline-flex items-center gap-1 text-xs uppercase tracking-widest text-sand-300 hover:text-white transition-colors mb-4">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Back to Home
        </a>
        <h1 class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
          Gallery
        </h1>
        <p class="mt-4 max-w-xl text-lg text-white">
          A visual journey through Corbett Foothills Retreat — from serene forest mornings to intimate farmstay moments.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-cream-dark py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {
        siteData.galleryCategories.map((cat, catIndex) => {
          const images = categoryImages[cat.name.toLowerCase().startsWith("jungle") ? "jungle" : cat.name.toLowerCase().startsWith("resort") ? "architecture" : "avian"] || [];
          return (
            <div class={catIndex > 0 ? "mt-16" : ""}>
              <div class="mb-8">
                <h2 class="font-display text-2xl font-bold text-cfr-green-dark sm:text-3xl">{cat.name}</h2>
                <p class="mt-2 text-base text-earth-600">{cat.description}</p>
              </div>
              <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-3">
                {images.map((img, imgIndex) => {
                  const aspect = aspectVariants[(catIndex * 3 + imgIndex) % aspectVariants.length];
                  return (
                    <div class={`overflow-hidden rounded-xl bg-white shadow-card transition-all duration-300 hover:shadow-glow hover:-translate-y-0.5 ${imgIndex === 0 ? "col-span-2 row-span-2" : ""}`}>
                      <img
                        src={img}
                        alt={`${cat.name} — image ${imgIndex + 1}`}
                        class={`h-full w-full object-cover ${aspect}`}
                        loading={catIndex === 0 && imgIndex < 2 ? "eager" : "lazy"}
                      />
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="bg-cfr-green-dark py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">Experience It Yourself</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white">
        Follow us on Instagram for daily moments from the retreat.
      </p>
      <div class="mt-6">
        <a
          href={siteData.site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-gradient-to-r from-purple-600 to-pink-500 px-8 py-4 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 016.11 2.525c.636-.247 1.363-.416 2.427-.465C8.83 2.013 9.942 2 12.315 2zm0 1.802c-2.373 0-2.7.01-3.656.053-1.023.047-1.58.218-1.95.362-.49.19-.84.416-1.207.783-.367.367-.593.717-.783 1.207-.144.37-.315.927-.362 1.95-.043.957-.053 1.283-.053 3.656 0 2.373.01 2.7.053 3.656.047 1.023.218 1.58.362 1.95.19.49.416.84.783 1.207.367.367.717.593 1.207.783.37.144.927.315 1.95.362.957.043 1.283.053 3.656.053 2.373 0 2.7-.01 3.656-.053 1.023-.047 1.58-.218 1.95-.362.49-.19.84-.416 1.207-.783.367-.367.593-.717.783-1.207.144-.37.315-.927.362-1.95.043-.957.053-1.283.053-3.656 0-2.373-.01-2.7-.053-3.656-.047-1.023-.218-1.58-.362-1.95-.19-.49-.416-.84-.783-1.207-.367-.367-.717-.593-1.207-.783-.37-.144-.927-.315-1.95-.362-.957-.043-1.283-.053-3.656-.053zm0 4.811a4.387 4.387 0 100 8.774 4.387 4.387 0 000-8.774zm0 1.802a2.585 2.585 0 110 5.17 2.585 2.585 0 010-5.17zm5.068-2.259a1.025 1.025 0 100 2.05 1.025 1.025 0 000-2.05z"/></svg>
          Follow on Instagram
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>
