---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../data/site.json";
---

<MainLayout title="Contact" description="Get in touch with Corbett Foothills Retreat. Call, WhatsApp, or email us to book your stay near Jim Corbett National Park, Ramnagar, Uttarakhand." breadcrumbs={[{name: "Contact"}]}>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <section class="relative flex min-h-[40vh] items-end overflow-hidden pt-56">
    <div class="absolute inset-0 bg-cfr-green-dark"></div>
    <div class="absolute inset-0 bg-hero-pattern"></div>
    <div class="absolute inset-0 bg-leaf-pattern opacity-30"></div>
    <div class="relative z-10 w-full bg-cfr-green-dark">
      <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 lg:pb-16">
      <div class="max-w-3xl">
        <a href="/" class="inline-flex items-center gap-1 text-xs uppercase tracking-widest text-cfr-sand-300 hover:text-white transition-colors mb-4">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Back to Home
        </a>
        <h1 class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
          Contact Us
        </h1>
        <p class="mt-4 max-w-xl text-lg text-white">
          We'd love to hear from you. Reach out to plan your stay, ask a question, or learn more about Corbett Foothills Retreat.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-cfr-cream-dark py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl font-bold text-cfr-green-dark sm:text-3xl">Get in Touch</h2>
          <p class="mt-2 text-base text-cfr-earth-600">
            Whether you're planning a <a href="/experiences" class="text-cfr-green-accent hover:text-cfr-green-dark underline">wildlife safari</a>, a <a href="/accommodation" class="text-cfr-green-accent hover:text-cfr-green-dark underline">family holiday</a>, or a quiet weekend getaway, our team is here to help.
          </p>

          <div class="mt-8 space-y-6">
            <div class="flex items-start gap-4">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-cfr-green-accent/10">
                <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-cfr-green-dark">Call or WhatsApp</p>
                <a href={`tel:${siteData.site.phone}`} class="text-base text-cfr-green-accent hover:text-cfr-green-dark transition-colors">{siteData.site.phone}</a>
                <div class="mt-2">
                  <a
                    href={`https://wa.me/${siteData.site.whatsapp.replace(/[^0-9]/g, "")}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white transition-all hover:bg-green-700"
                  >
                    <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    WhatsApp Us
                  </a>
                </div>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-cfr-green-accent/10">
                <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-cfr-green-dark">Email</p>
                <a href={`mailto:${siteData.site.email}`} class="text-base text-cfr-green-accent hover:text-cfr-green-dark transition-colors break-all">{siteData.site.email}</a>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-cfr-green-accent/10">
                <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-cfr-green-dark">Address</p>
                <p class="text-base text-cfr-earth-600">{siteData.site.location}</p>
                <a
                  href={siteData.site.googleMaps}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 inline-flex items-center gap-1 text-sm text-cfr-green-accent hover:text-cfr-green-dark transition-colors"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                  Open in Google Maps
                </a>
              </div>
            </div>
          </div>

          <div class="mt-10">
            <h3 class="font-display text-xl font-bold text-cfr-green-dark">How to Reach Us</h3>
            <div class="mt-4 space-y-4">
              <div class="rounded-lg border border-cfr-earth-200 bg-white p-4">
                <p class="flex items-center gap-2 font-semibold text-cfr-green-dark">
                  <svg class="h-4 w-4 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 15v-4a2 2 0 012-2h12a2 2 0 012 2v4" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 9V6a1 1 0 00-1-1h-3a1 1 0 00-1 1v3" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 9V6M6 6h4" />
                    <circle cx="5" cy="12" r="1" />
                    <rect x="9" y="11" width="6" height="2.5" rx="0.5" />
                    <circle cx="7.5" cy="17" r="1.5" />
                    <circle cx="12" cy="17" r="1.5" />
                    <circle cx="16.5" cy="17" r="1.5" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2 20h20" />
                  </svg>
                  By Train
                </p>
                <p class="mt-1 text-sm text-cfr-earth-600">{siteData.site.nearestRailway}. Taxis and auto-rickshaws are readily available outside the station.</p>
              </div>
              <div class="rounded-lg border border-cfr-earth-200 bg-white p-4">
                <p class="flex items-center gap-2 font-semibold text-cfr-green-dark">
                  <svg class="h-4 w-4 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                  </svg>
                  By Air
                </p>
                <p class="mt-1 text-sm text-cfr-earth-600">{siteData.site.nearestAirport}. Pre-booked taxis and rental cars are available from both airports.</p>
              </div>
              <div class="rounded-lg border border-cfr-earth-200 bg-white p-4">
                <p class="flex items-center gap-2 font-semibold text-cfr-green-dark">
                  <svg class="h-4 w-4 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 13v-2a1 1 0 011-1h1.5l2-4h9l2 4H20a1 1 0 011 1v2M7 15a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM20 15a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM8 12h8" />
                  </svg>
                  By Road
                </p>
                <p class="mt-1 text-sm text-cfr-earth-600">The retreat is well-connected by road from Delhi (260 km / ~5-6 hours), Nainital (65 km), and other major Uttarakhand towns. We can assist with reliable taxi contacts upon booking.</p>
              </div>
            </div>
          </div>
          <div class="mt-8">
            <a href="/blogs" class="inline-flex items-center gap-2 text-sm font-semibold text-cfr-green-accent hover:text-cfr-green-dark transition-colors">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
              </svg>
              Read Our Travel Blog
            </a>
          </div>
        </div>

        <div>
          <h2 class="font-display text-2xl font-bold text-cfr-green-dark sm:text-3xl">Send Us a Message</h2>
          <p class="mt-2 text-base text-cfr-earth-600">
            Fill in the form below and we'll get back to you within 24 hours.
          </p>

          <form id="contact-form" class="mt-8 space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="block text-sm font-medium text-cfr-green-dark">Full Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Your name"
                  class="mt-1 block w-full rounded-lg border border-cfr-earth-300 bg-white px-4 py-3 text-sm text-cfr-earth-900 placeholder-cfr-earth-400 shadow-sm transition-colors focus:border-cfr-green-accent focus:ring-2 focus:ring-cfr-green-accent/20 focus:outline-none"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-cfr-green-dark">Email Address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="you@example.com"
                  class="mt-1 block w-full rounded-lg border border-cfr-earth-300 bg-white px-4 py-3 text-sm text-cfr-earth-900 placeholder-cfr-earth-400 shadow-sm transition-colors focus:border-cfr-green-accent focus:ring-2 focus:ring-cfr-green-accent/20 focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-cfr-green-dark">Phone Number</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+91 98xxx xxxxx"
                class="mt-1 block w-full rounded-lg border border-cfr-earth-300 bg-white px-4 py-3 text-sm text-cfr-earth-900 placeholder-cfr-earth-400 shadow-sm transition-colors focus:border-cfr-green-accent focus:ring-2 focus:ring-cfr-green-accent/20 focus:outline-none"
              />
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="checkin" class="block text-sm font-medium text-cfr-green-dark">Check-in Date</label>
                <input
                  type="date"
                  id="checkin"
                  name="checkin"
                  class="mt-1 block w-full rounded-lg border border-cfr-earth-300 bg-white px-4 py-3 text-sm text-cfr-earth-900 shadow-sm transition-colors focus:border-cfr-green-accent focus:ring-2 focus:ring-cfr-green-accent/20 focus:outline-none"
                />
              </div>
              <div>
                <label for="checkout" class="block text-sm font-medium text-cfr-green-dark">Check-out Date</label>
                <input
                  type="date"
                  id="checkout"
                  name="checkout"
                  class="mt-1 block w-full rounded-lg border border-cfr-earth-300 bg-white px-4 py-3 text-sm text-cfr-earth-900 shadow-sm transition-colors focus:border-cfr-green-accent focus:ring-2 focus:ring-cfr-green-accent/20 focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label for="guests" class="block text-sm font-medium text-cfr-green-dark">Number of Guests</label>
              <select
                id="guests"
                name="guests"
                class="mt-1 block w-full rounded-lg border border-cfr-earth-300 bg-white px-4 py-3 text-sm text-cfr-earth-900 shadow-sm transition-colors focus:border-cfr-green-accent focus:ring-2 focus:ring-cfr-green-accent/20 focus:outline-none"
              >
                <option value="">Select...</option>
                <option value="1">1 Guest</option>
                <option value="2">2 Guests</option>
                <option value="3">3 Guests</option>
                <option value="4">4 Guests</option>
                <option value="5">5 Guests</option>
                <option value="6+">6+ Guests</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-cfr-green-dark">Your Message</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Tell us about your travel plans, preferences, or any questions you have..."
                class="mt-1 block w-full rounded-lg border border-cfr-earth-300 bg-white px-4 py-3 text-sm text-cfr-earth-900 placeholder-cfr-earth-400 shadow-sm transition-colors focus:border-cfr-green-accent focus:ring-2 focus:ring-cfr-green-accent/20 focus:outline-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full rounded-lg bg-cfr-green-accent px-6 py-4 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2"
            >
              Send Message
            </button>

            <p class="text-xs text-cfr-earth-500 text-center">
              By submitting this form, you agree to be contacted regarding your inquiry. Your data will not be used for marketing purposes.
            </p>
            <p id="contact-msg" class="text-xs text-center hidden"></p>
          </form>
          <script>
            document.getElementById("contact-form")?.addEventListener("submit", async (e) => {
              e.preventDefault();
              const form = e.currentTarget;
              const btn = form.querySelector('button[type="submit"]');
              const msg = document.getElementById("contact-msg");
              const name = form.querySelector("#name").value.trim();
              const email = form.querySelector("#email").value.trim();
              const phone = form.querySelector("#phone").value.trim();
              const checkin = form.querySelector("#checkin").value;
              const checkout = form.querySelector("#checkout").value;
              const guests = form.querySelector("#guests").value;
              const message = form.querySelector("#message").value.trim();

              if (!name || !email || !message) {
                msg.textContent = "Please fill in your name, email, and message.";
                msg.className = "text-xs text-center text-red-500";
                msg.classList.remove("hidden");
                return;
              }

              btn.textContent = "Sending…";
              btn.disabled = true;
              msg.classList.add("hidden");

              try {
                const res = await fetch("/contact", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ name, email, phone, checkin, checkout, guests, message }),
                });
                const json = await res.json();
                if (json.success) {
                  msg.textContent = "Thank you! We'll get back to you within 24 hours.";
                  msg.className = "text-xs text-center text-cfr-green-accent";
                  msg.classList.remove("hidden");
                  form.reset();
                  window.CFR_ANALYTICS?.track("contact_submitted", {
                    property_name: "Corbett Foothills Retreat",
                  });
                } else {
                  msg.textContent = json.error || "Something went wrong. Please try again.";
                  msg.className = "text-xs text-center text-red-500";
                  msg.classList.remove("hidden");
                }
              } catch {
                msg.textContent = "Network error. Please try again.";
                msg.className = "text-xs text-center text-red-500";
                msg.classList.remove("hidden");
              }

              btn.textContent = "Send Message";
              btn.disabled = false;
            });
          </script>
        </div>
      </div>
    </div>
  </section>

  <section class="h-[450px] w-full overflow-hidden">
    <iframe
      src={siteData.site.googleMapsEmbed}
      width="100%"
      height="100%"
      style="border:0"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Corbett Foothills Retreat location"
    >
    </iframe>
  </section>

  <section class="bg-cfr-green-dark py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">Ready to Book Your Stay?</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white">
        Experience the perfect blend of farm life and luxury at the edge of the Jim Corbett forest.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href="/booking/"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !px-10 !py-4"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Book Your Stay
        </a>
        <a href="tel:+919818193314" class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-cfr-sand-500 px-6 py-3 text-sm font-semibold text-cfr-sand-200 transition-all duration-300 hover:bg-cfr-sand-500/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-sand-500 focus-visible:ring-offset-2 !rounded-full !px-10 !py-4">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Call +91 98181 93314
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>
