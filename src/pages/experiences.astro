---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../data/site.json";
---

<MainLayout title="Experiences" description="Discover jungle safaris in Dhela & Jhirna zones, guided wilderness walks, bird watching, riverside bonfires, and organic farming at Corbett Foothills Retreat near Jim Corbett National Park." breadcrumbs={[{name: "Experiences"}]}>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <section class="relative flex min-h-[40vh] items-end overflow-hidden pt-56">
    <div class="absolute inset-0 bg-cfr-green-dark"></div>
    <div class="absolute inset-0 bg-hero-pattern"></div>
    <div class="absolute inset-0 bg-leaf-pattern opacity-30"></div>
    <div class="relative z-10 w-full bg-cfr-green-dark">
      <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 lg:pb-16">
      <div class="max-w-3xl">
        <a href="/" class="inline-flex items-center gap-1 text-xs uppercase tracking-widest text-cfr-sand-300 hover:text-white transition-colors mb-4">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Back to Home
        </a>
        <h1 class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
          Experiences
        </h1>
        <p class="mt-4 max-w-xl text-lg text-white">
          Discover jungle safaris, guided wilderness walks, bird watching, riverside bonfires, and organic farming at Corbett Foothills Retreat.
        </p>
      </div>
    </div>
  </section>

  {
    siteData.experiences.map((exp, index) => {
      const bgClass = index % 2 === 0 ? "bg-cfr-cream-dark" : "bg-cfr-green-dark";
      const textClass = index % 2 === 0 ? "text-cfr-green-dark" : "text-white";
      const bodyClass = index % 2 === 0 ? "text-cfr-earth-600" : "text-white";
      const highlightClass = index % 2 === 0 ? "text-cfr-earth-700" : "text-white";
      return (
        <section class={`${bgClass} py-16 sm:py-20`}>
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="mx-auto max-w-3xl">
              <h2 class={`font-display text-3xl font-bold ${textClass} sm:text-4xl`}>{exp.title}</h2>
              <div class={`mt-4 space-y-4 text-base leading-relaxed ${bodyClass}`}>
                {exp.description.split("\n").filter(Boolean).map((para) => (
                  <p>{para.trim()}</p>
                ))}
              </div>
              {exp.highlightsTitle && exp.highlights && exp.highlights.length > 0 && (
                <div class="mt-6">
                  <p class={`text-sm font-semibold uppercase tracking-widest ${index % 2 === 0 ? 'text-cfr-green-accent' : 'text-cfr-sand-300'}`}>{exp.highlightsTitle}</p>
                  <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                    {exp.highlights.map((h) => (
                      <li class="flex items-start gap-2">
                        <svg class="mt-0.5 h-4 w-4 shrink-0 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        <span class={`text-sm ${highlightClass}`}>{h}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
            {exp.images && exp.images.length > 0 && (
              <div class="mt-10 grid gap-4 sm:grid-cols-3">
                {exp.images.map((img) => (
                  <div class="aspect-[4/3] overflow-hidden rounded-xl shadow-card">
                    <img src={img} alt={exp.title} class="h-full w-full object-cover" loading="lazy" />
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      );
    })
  }

  <section class="bg-cfr-green-dark py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
        Ready to Experience Corbett?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white">
        Whether you seek wildlife encounters, peaceful nature walks, or a deeper connection with sustainable living, Corbett Foothills Retreat offers memorable experiences for guests of all ages.
      </p>
      <div class="mt-4 flex flex-wrap justify-center gap-4">
        <a href="/blogs/complete-guide-to-jim-corbett-safari-booking" class="text-sm font-semibold text-cfr-sand-300 hover:text-white underline">Safari Booking Guide</a>
        <span class="text-cfr-sand-500">&middot;</span>
        <a href="/blogs/things-to-do-jim-corbett" class="text-sm font-semibold text-cfr-sand-300 hover:text-white underline">Things to Do Near Corbett</a>
      </div>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-lg bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !px-10 !py-4">
          Book Your Stay
        </a>
        <a href="/gallery" class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-cfr-green-accent px-6 py-3 text-sm font-semibold text-cfr-green-accent transition-all duration-300 hover:bg-cfr-green-accent hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !border-cfr-sand-500 !px-10 !py-4 !text-cfr-sand-200 hover:!bg-cfr-sand-500/20">
          View Photo Gallery
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-cfr-green-accent px-6 py-3 text-sm font-semibold text-cfr-green-accent transition-all duration-300 hover:bg-cfr-green-accent hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !border-cfr-sand-500 !px-10 !py-4 !text-cfr-sand-200 hover:!bg-cfr-sand-500/20">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>
