---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../data/site.json";
---

<MainLayout title="Experiences" description="Discover jungle safaris in Dhela & Jhirna zones, guided wilderness walks, bird watching, riverside bonfires, and organic farming at Corbett Foothills Retreat near Jim Corbett National Park.">
  <Fragment slot="header">
    <Header />
  </Fragment>

  <section class="relative flex min-h-[50vh] items-end overflow-hidden bg-cfr-green-dark pt-24">
    <div class="absolute inset-0 bg-hero-pattern"></div>
    <div class="absolute inset-0 bg-leaf-pattern opacity-30"></div>
    <div class="relative mx-auto w-full max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 lg:pb-16">
      <div class="max-w-3xl">
        <a href="/" class="inline-flex items-center gap-1 text-xs uppercase tracking-widest text-sand-300 hover:text-white transition-colors mb-4">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Back to Home
        </a>
        <h1 class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
          Experiences
        </h1>
        <p class="mt-4 max-w-xl text-lg text-white">
          At Corbett Foothills Retreat, every stay is an opportunity to reconnect with nature. Surrounded by forests, fresh mountain air, and the rich biodiversity of the Jim Corbett landscape, our guests can enjoy a range of experiences that combine adventure, relaxation, and authentic rural living.
        </p>
      </div>
    </div>
  </section>

  {
    siteData.experiences.map((exp, index) => {
      const imgUrl = index < siteData.images.gallery.length
        ? siteData.images.gallery[index]
        : siteData.images.hero[index % siteData.images.hero.length];
      return (
        <section class={index % 2 === 0 ? "bg-cream-dark py-16 sm:py-20" : "bg-cfr-green-dark py-16 sm:py-20"}>
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid gap-8 lg:grid-cols-2 lg:items-center">
              <div class={index % 2 === 1 ? "lg:order-last" : ""}>
                <h2 class={index % 2 === 0 ? "font-display text-3xl font-bold text-cfr-green-dark sm:text-4xl" : "font-display text-3xl font-bold text-white sm:text-4xl"}>
                  {exp.title}
                </h2>
                <div class={index % 2 === 0 ? "mt-4 space-y-4 text-base leading-relaxed text-earth-600" : "mt-4 space-y-4 text-base leading-relaxed text-white"}>
                  {exp.description.split("\n").filter(Boolean).map((para) => (
                    <p>{para.trim()}</p>
                  ))}
                </div>
                {exp.highlights && exp.highlights.length > 0 && (
                  <ul class="mt-6 space-y-3">
                    {exp.highlights.map((h) => (
                      <li class="flex items-start gap-3">
                        <svg class="mt-0.5 h-5 w-5 shrink-0 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        <span class={index % 2 === 0 ? "text-sm text-earth-700" : "text-sm text-white"}>{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <div class={`relative aspect-[4/3] overflow-hidden rounded-2xl ${index % 2 === 1 ? 'lg:order-first' : ''}`}>
                <img
                  src={imgUrl}
                  alt={exp.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="bg-cfr-green-dark py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
        Ready to Experience Corbett?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white">
        Whether you seek wildlife encounters, peaceful nature walks, or a deeper connection with sustainable living, Corbett Foothills Retreat offers memorable experiences for guests of all ages.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-lg bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !px-10 !py-4">
          Book Your Stay
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-cfr-green-accent px-6 py-3 text-sm font-semibold text-cfr-green-accent transition-all duration-300 hover:bg-cfr-green-accent hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !border-sand-500 !px-10 !py-4 !text-sand-200 hover:!bg-sand-500/20">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>
