---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../data/site.json";

const siteUrl = Astro.site || new URL("https://corbett.life");

const roomCategories = [
  {
    name: "Forest View Room",
    description: "Comfortable room with forest-facing views, king-size bed, and modern amenities. Perfect for couples and solo travellers seeking a peaceful nature retreat.",
    capacity: "2 adults",
    size: "Spacious",
    image: "/images/luxury-room-style.webp",
  },
  {
    name: "Premium Suite",
    description: "Larger suite with enhanced interiors, premium furnishings, and expansive views of the surrounding property. Ideal for families or guests seeking extra space.",
    capacity: "3 adults or 2 adults + 1 child",
    size: "Large",
    image: siteData.images.accommodation[2],
  },
  {
    name: "Garden Room",
    description: "Ground-floor room opening onto the organic farm and garden areas. Quiet, private, and ideal for guests travelling with pets or young children.",
    capacity: "2 adults + 1 child",
    size: "Spacious",
    image: siteData.images.accommodation[1],
  },
];

const cotRate = "₹750";

const includedItems = [
  "Comfortable king-size bed with premium linen",
  "Air conditioning",
  "Modern attached bathroom with hot water",
  "High-speed Wi-Fi",
  "Freshly cooked breakfast",
  "Daily housekeeping",
  "Complimentary parking",
  "Farm-to-table dining options (available on prior order)",
  "Organic farming experience",
  "Nature walks on the property",
  "Pet-friendly stay (no extra charges)",
  "Safari planning assistance",
];
---

<MainLayout
  title="Tariff & Pricing"
  description="Room rates at Corbett Foothills Retreat — weekday and weekend pricing at a boutique farmstay near Jim Corbett National Park. Transparent pricing with no hidden charges."
  breadcrumbs={[{name: "Tariff"}]}
>
  <Fragment slot="head">
    <link rel="preload" href={roomCategories[0].image} as="image" fetchpriority="high" />
  </Fragment>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    name: "Accommodation at Corbett Foothills Retreat",
    description: "Boutique farmstay accommodation near Jim Corbett National Park with six exclusive suites, organic farm, and personalised hospitality.",
    brand: { "@type": "Brand", name: "Corbett Foothills Retreat" },
    offers: roomCategories.map((room) => ({
      "@type": "Offer",
      name: room.name,
      description: room.description,
      price: "2250",
      priceCurrency: "INR",
      availability: "https://schema.org/InStock",
      url: new URL("/tariff", siteUrl).href,
      validFrom: "2026-01-01",
      validThrough: "2026-12-31",
    })),
    image: roomCategories.map((r) => new URL(r.image, siteUrl).href),
  })} />

  <section class="relative flex min-h-[40vh] items-end overflow-hidden pt-56">
    <div class="absolute inset-0 bg-cfr-green-dark"></div>
    <div class="absolute inset-0 bg-hero-pattern"></div>
    <div class="absolute inset-0 bg-leaf-pattern opacity-30"></div>
    <div class="relative z-10 w-full bg-cfr-green-dark">
      <div class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 lg:pb-16">
        <div class="max-w-3xl">
          <a href="/" class="mb-4 inline-flex items-center gap-1 text-xs uppercase tracking-widest text-cfr-sand-300 transition-colors hover:text-white">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Back to Home
          </a>
          <h1 class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
            Tariff & Pricing
          </h1>
          <p class="mt-4 max-w-xl text-lg text-white">
            Transparent pricing with no hidden charges. All rates include complimentary breakfast and access to property amenities.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cfr-cream-dark py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl font-bold text-cfr-green-dark sm:text-4xl">Our Room Categories</h2>
        <p class="mt-4 text-lg text-cfr-earth-600">
          All six rooms at Corbett Foothills Retreat are thoughtfully designed to provide comfort, privacy, and a deep connection with nature.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {roomCategories.map((room) => (
          <div class="flex flex-col overflow-hidden rounded-2xl bg-white shadow-card transition-all duration-300 hover:shadow-glow hover:-translate-y-1">
            <div class="aspect-[4/3] overflow-hidden">
              <img src={room.image} alt={room.name} class="h-full w-full object-cover" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-display text-xl font-bold text-cfr-green-dark">{room.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-cfr-earth-600">{room.description}</p>
              <div class="mt-4 space-y-1 text-sm text-cfr-earth-500">
                <p><span class="font-semibold text-cfr-green-dark">Capacity:</span> {room.capacity}</p>
              </div>
              <div class="mt-4 space-y-2 border-t border-cfr-earth-100 pt-4">
                <p class="flex items-center justify-between text-sm"><span class="text-cfr-earth-500">Weekdays (Mon–Thu)</span> <span class="font-semibold text-cfr-green-dark">₹2,250<span class="font-normal text-cfr-earth-400">/night</span></span></p>
                <p class="flex items-center justify-between text-sm"><span class="text-cfr-earth-500">Weekends (Fri–Sun)</span> <span class="font-semibold text-cfr-green-dark">₹2,500<span class="font-normal text-cfr-earth-400">/night</span></span></p>
                <p class="flex items-center justify-between text-xs text-cfr-earth-400"><span>Additional cot: {cotRate}/night</span></p>
              </div>
              <a href="/contact" class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5">
                Enquire About This Room
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cfr-green-dark py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <h2 class="font-display text-3xl font-bold text-white sm:text-4xl text-center">How Pricing Works</h2>
        <p class="mt-4 text-center text-lg text-white">
          Rates are based on your day of arrival. All prices are per room per night and include taxes. Breakfast is complimentary.
        </p>
        <div class="mt-10 grid gap-6 sm:grid-cols-3">
          <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
            <h3 class="font-display text-xl font-bold text-white">Weekday Rate</h3>
            <p class="mt-1 text-sm font-semibold text-cfr-green-accent">Mon–Thu</p>
            <p class="mt-3 text-2xl font-bold text-white">₹2,250<span class="text-sm font-normal text-white/60">/night</span></p>
            <p class="mt-2 text-sm leading-relaxed text-white/70">The standard rate for any stay beginning Monday to Thursday.</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
            <h3 class="font-display text-xl font-bold text-white">Weekend Rate</h3>
            <p class="mt-1 text-sm font-semibold text-cfr-green-accent">Fri–Sun</p>
            <p class="mt-3 text-2xl font-bold text-white">₹2,500<span class="text-sm font-normal text-white/60">/night</span></p>
            <p class="mt-2 text-sm leading-relaxed text-white/70">Applied to stays beginning Friday, Saturday, or Sunday.</p>
          </div>
          <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
            <h3 class="font-display text-xl font-bold text-white">Additional Cot</h3>
            <p class="mt-1 text-sm font-semibold text-cfr-green-accent">If needed</p>
            <p class="mt-3 text-2xl font-bold text-white">₹750<span class="text-sm font-normal text-white/60">/night</span></p>
            <p class="mt-2 text-sm leading-relaxed text-white/70">For a third adult or extra bedding, available in select rooms.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cfr-cream-dark py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <h2 class="font-display text-3xl font-bold text-cfr-green-dark sm:text-4xl text-center">What's Included</h2>
        <p class="mt-4 text-center text-lg text-cfr-earth-600">
          Every stay at Corbett Foothills Retreat includes the following amenities and services.
        </p>
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          {includedItems.map((item) => (
            <div class="flex items-start gap-3 rounded-xl bg-white px-5 py-4 shadow-card">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-sm text-cfr-earth-700">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <h2 class="sr-only" id="faqs">Frequently Asked Questions about Pricing</h2>
  <section class="bg-white py-16 sm:py-20" aria-labelledby="faqs">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-bold text-cfr-green-dark sm:text-4xl text-center">Frequently Asked Questions</h2>
      <div class="mt-10 space-y-4">
        <details class="group rounded-xl border border-cfr-earth-200 p-5 transition-all duration-200 open:border-cfr-green-accent open:shadow-sm">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-cfr-green-dark">
            Are taxes included in the rates?
            <svg class="h-4 w-4 shrink-0 text-cfr-earth-400 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-cfr-earth-600">Yes, all rates include applicable taxes. There are no hidden charges. The price displayed is the total room rate per night.</p>
        </details>
        <details class="group rounded-xl border border-cfr-earth-200 p-5 transition-all duration-200 open:border-cfr-green-accent open:shadow-sm">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-cfr-green-dark">
            Is breakfast included in the room rate?
            <svg class="h-4 w-4 shrink-0 text-cfr-earth-400 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-cfr-earth-600">Yes, a freshly cooked breakfast is included with every stay. Lunch, dinner, and special dietary requirements can be arranged on prior order at additional cost.</p>
        </details>
        <details class="group rounded-xl border border-cfr-earth-200 p-5 transition-all duration-200 open:border-cfr-green-accent open:shadow-sm">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-cfr-green-dark">
            Do you charge extra for pets?
            <svg class="h-4 w-4 shrink-0 text-cfr-earth-400 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-cfr-earth-600">No. Pets are welcome at Corbett Foothills Retreat with no extra charges. Please let us know in advance so we can prepare for your furry companion's stay.</p>
        </details>
        <details class="group rounded-xl border border-cfr-earth-200 p-5 transition-all duration-200 open:border-cfr-green-accent open:shadow-sm">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-cfr-green-dark">
            What is the cancellation policy?
            <svg class="h-4 w-4 shrink-0 text-cfr-earth-400 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-cfr-earth-600">Cancellations made 7 days or more before check-in receive a full refund. Cancellations within 3 to 7 days incur a 50% charge. Cancellations less than 3 days before check-in are non-refundable. Please contact us for special circumstances.</p>
        </details>
        <details class="group rounded-xl border border-cfr-earth-200 p-5 transition-all duration-200 open:border-cfr-green-accent open:shadow-sm">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-cfr-green-dark">
            Is there a minimum stay requirement?
            <svg class="h-4 w-4 shrink-0 text-cfr-earth-400 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-cfr-earth-600">During peak season (October to February), a minimum stay of 2 nights may apply on weekends and holidays. During summer and monsoon seasons, single-night bookings are welcome subject to availability.</p>
        </details>
        <details class="group rounded-xl border border-cfr-earth-200 p-5 transition-all duration-200 open:border-cfr-green-accent open:shadow-sm">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-cfr-green-dark">
            Can I book safari through the retreat?
            <svg class="h-4 w-4 shrink-0 text-cfr-earth-400 transition-transform duration-200 group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-cfr-earth-600">We provide safari planning assistance and can help arrange jeep safaris in the nearby Dhela, Jhirna, and other zones. Safari permits and vehicle charges are separate from accommodation costs. Please refer to our <a href="/blogs/complete-guide-to-jim-corbett-safari-booking" class="text-cfr-green-accent underline hover:text-cfr-green-dark">safari booking guide</a> for detailed information.</p>
        </details>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      { "@type": "Question", name: "Are taxes included in the rates?", acceptedAnswer: { "@type": "Answer", text: "Yes, all rates include applicable taxes. There are no hidden charges. The price displayed is the total room rate per night." } },
      { "@type": "Question", name: "Is breakfast included in the room rate?", acceptedAnswer: { "@type": "Answer", text: "Yes, a freshly cooked breakfast is included with every stay. Lunch, dinner, and special dietary requirements can be arranged on prior order at additional cost." } },
      { "@type": "Question", name: "Do you charge extra for pets?", acceptedAnswer: { "@type": "Answer", text: "No. Pets are welcome at Corbett Foothills Retreat with no extra charges. Please let us know in advance so we can prepare for your furry companion's stay." } },
      { "@type": "Question", name: "What is the cancellation policy?", acceptedAnswer: { "@type": "Answer", text: "Cancellations made 7 days or more before check-in receive a full refund. Cancellations within 3 to 7 days incur a 50% charge. Cancellations less than 3 days before check-in are non-refundable." } },
      { "@type": "Question", name: "Is there a minimum stay requirement?", acceptedAnswer: { "@type": "Answer", text: "During peak season (October to February), a minimum stay of 2 nights may apply on weekends and holidays. During summer and monsoon seasons, single-night bookings are welcome subject to availability." } },
      { "@type": "Question", name: "Can I book safari through the retreat?", acceptedAnswer: { "@type": "Answer", text: "We provide safari planning assistance and can help arrange jeep safaris in the nearby Dhela, Jhirna, and other zones. Safari permits and vehicle charges are separate from accommodation costs." } },
    ],
  })} />

  <section class="bg-cfr-green-dark py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
        Ready to Book Your Stay?
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white">
        Contact us to check availability, discuss special requirements, or customise a package that suits your travel plans. We're here to help.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-full bg-cfr-green-accent px-10 py-4 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5">
          Enquire Now
        </a>
        <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-cfr-sand-500 px-10 py-4 text-sm font-semibold text-cfr-sand-200 transition-all duration-300 hover:bg-cfr-sand-500/20">
          View Accommodation
        </a>
        <a href="/gallery" class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-cfr-green-accent px-10 py-4 text-sm font-semibold text-cfr-green-accent transition-all duration-300 hover:bg-cfr-green-accent hover:text-white !border-cfr-sand-500 !text-cfr-sand-200 hover:!bg-cfr-sand-500/20">
          View Photo Gallery
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>