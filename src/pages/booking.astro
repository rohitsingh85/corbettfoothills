        e.preventDefault();
        lightboxPrev();
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        lightboxNext();
      } else if (e.key === "Tab") {
        var focusables = Array.prototype.slice.call(document.querySelectorAll("#cfr-lightbox button"));
        if (focusables.length === 0) return;
        var first = focusables[0];
        var last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }

    function initLightbox() {
      var lb = document.getElementById("cfr-lightbox");
      if (!lb) return;
      var track = document.getElementById("cfr-lightbox-track");
      var closeBtn = document.getElementById("cfr-lightbox-close");
      var prevBtn = document.getElementById("cfr-lightbox-prev");
      var nextBtn = document.getElementById("cfr-lightbox-next");
      var backdrop = document.getElementById("cfr-lightbox-backdrop");

      if (closeBtn) closeBtn.addEventListener("click", function () { closeLightbox(); });
      if (prevBtn) prevBtn.addEventListener("click", function (e) { e.preventDefault(); lightboxPrev(); });
      if (nextBtn) nextBtn.addEventListener("click", function (e) { e.preventDefault(); lightboxNext(); });

      lb.addEventListener("click", function (e) {
        if (e.target === lb || (backdrop && e.target === backdrop)) closeLightbox();
      });

      track.addEventListener("transitionend", function (e) {
        if (e.target !== track || e.propertyName !== "transform") return;
        lightboxFinishMove();
      });

      document.addEventListener("keydown", onLightboxKeydown);

      var viewport = document.getElementById("cfr-lightbox-viewport");
      var pointer = { down: false, startX: 0, deltaX: 0, dragging: false };
      var suppress = false;
      viewport.addEventListener("pointerdown", function (e) {
        pointer.down = true;
        pointer.startX = e.clientX;
        pointer.deltaX = 0;
        pointer.dragging = false;
      });
      viewport.addEventListener("pointermove", function (e) {
        if (!pointer.down) return;
        pointer.deltaX = e.clientX - pointer.startX;
        if (Math.abs(pointer.deltaX) > 8) pointer.dragging = true;
      });
      viewport.addEventListener("pointerup", function () {
        if (!pointer.down) return;
        pointer.down = false;
        if (pointer.dragging) {
          suppress = true;
          if (pointer.deltaX < -40) lightboxNext();
          else if (pointer.deltaX > 40) lightboxPrev();
          pointer.dragging = false;
          setTimeout(function () { suppress = false; }, 60);
        }
      });
      viewport.addEventListener("pointercancel", function () {
        pointer.down = false;
        pointer.dragging = false;
      });
      viewport.addEventListener("click", function (e) {
        if (suppress) e.preventDefault();
      });
    }

    function renderResults(data) {
      roomsGrid.innerHTML = "";

      const nights = Math.ceil(
        (new Date(data.checkout + "T00:00:00") -
          new Date(data.checkin + "T00:00:00")) /
          86400000
      );

      resultsSummary.textContent =
        data.rooms.length +
        " room" +
        (data.rooms.length !== 1 ? "s" : "") +
        " available · " +
        nights +
        " night" +
        (nights !== 1 ? "s" : "") +
        " · " +
        formatDisplayDate(data.checkin) +
        " – " +
        formatDisplayDate(data.checkout);

      data.rooms.forEach((apiRoom) => {
        const content = resolveRoomContent(apiRoom.slug, ROOM_CONTENT);
        const card = createRoomCard(apiRoom, content, nights);
        roomsGrid.appendChild(card);
        const carousel = card.querySelector("[data-carousel]");
        if (carousel) initRoomCarousel(carousel, (content && content.name ? content.name : apiRoom.name));
      });
    }

    function createRoomCard(apiRoom, content, nights) {
      const card = document.createElement("article");
      card.className =
        "overflow-hidden rounded-2xl bg-white shadow-card transition-all duration-300 hover:shadow-glow hover:-translate-y-1 room-card-enter";
      card.setAttribute(
        "aria-label",
        (content && content.name ? content.name : apiRoom.name) + " room"
      );

      const name = content && content.name ? content.name : apiRoom.name;
      const description = content ? content.shortDescription : "";
      const image = content ? content.image : "";
      const maxOccupancy = content
        ? content.maxOccupancy.adults +
          (content.maxOccupancy.children > 0
            ? " Adults + " + content.maxOccupancy.children + " Children"
            : " Adults")
        : "";
      const bedType = content ? content.bedType : "";
      const area = content ? content.area : "";
      const smoking = content ? content.smoking : false;
      const accessibility = content ? content.accessibility : false;
      const cancellationPolicy = content
        ? content.cancellationPolicy
        : apiRoom.cancellationPolicy || "";

      const available = apiRoom.available;
      const roomsLeft = apiRoom.roomsLeft || 0;
      const nightlyRate = apiRoom.nightlyRate;
      const originalRate = apiRoom.originalNightlyRate;
      const totalStay = apiRoom.totalStay;
      const originalTotal = apiRoom.originalTotal;
      const grandTotal = apiRoom.grandTotal;
      const taxBreakdown = apiRoom.taxBreakdown || [];
      const totalTaxes = apiRoom.totalTaxes || 0;

      let imageHtml = "";
      const gallery =
        content && content.gallery && content.gallery.length > 0
          ? content.gallery
          : image
          ? [image]
          : [];
      if (gallery.length > 0) {
        imageHtml =
          '<div class="relative cfr-carousel-wrap aspect-[16/10] sm:aspect-[16/7]">' +
          buildCarouselHtml(gallery, name) +
          (!available
            ? '<div class="absolute inset-0 z-10 flex items-center justify-center bg-black/45"><span class="rounded-full bg-white/95 px-4 py-1.5 text-sm font-bold text-cfr-earth-700">Not Available</span></div>'
            : roomsLeft > 0 && roomsLeft <= 3
            ? '<div class="absolute top-3 right-3 z-10 rounded-full bg-cfr-sand-500 px-3 py-1 text-xs font-bold text-cfr-earth-700 shadow-sm">Only ' + roomsLeft + " left</div>"
            : "") +
          "</div>" +
          buildThumbsHtml(gallery, name);
      }

      let infoChips = "";
      if (maxOccupancy)
        infoChips +=
          '<span class="inline-flex items-center gap-1 rounded-full bg-cfr-cream px-2.5 py-1 text-[11px] font-medium text-cfr-earth-600"><svg class="h-3 w-3 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>' +
          maxOccupancy +
          "</span>";
      if (bedType)
        infoChips +=
          '<span class="inline-flex items-center gap-1 rounded-full bg-cfr-cream px-2.5 py-1 text-[11px] font-medium text-cfr-earth-600"><svg class="h-3 w-3 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>' +
          bedType +
          "</span>";
      if (area)
        infoChips +=
          '<span class="inline-flex items-center gap-1 rounded-full bg-cfr-cream px-2.5 py-1 text-[11px] font-medium text-cfr-earth-600"><svg class="h-3 w-3 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" /></svg>' +
          area +
          "</span>";

      let amenityHtml = "";
      if (FEATURED_AMENITIES.length > 0) {
        amenityHtml =
          '<div class="mt-5 border-t border-cfr-earth-100 pt-4">' +
          '<h4 class="text-[11px] font-semibold uppercase tracking-wider text-cfr-earth-400">Amenities</h4>' +
          '<ul class="mt-3 grid grid-cols-1 gap-x-4 gap-y-2.5 sm:grid-cols-2">' +
          FEATURED_AMENITIES.map(function (a) {
            return (
              '<li class="flex items-center gap-2.5 text-xs text-cfr-earth-600">' +
              '<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-cfr-green-50 text-cfr-green-accent">' +
              (AMENITY_ICONS[a] || "") +
              "</span>" +
              "<span>" +
              a +
              "</span>" +
              "</li>"
            );
          }).join("") +
          "</ul>" +
          "</div>";
      }

      let indicators = "";
      if (smoking)
        indicators +=
          '<span class="inline-flex items-center gap-1 rounded-full bg-cfr-sand-100 px-2 py-0.5 text-[10px] font-medium text-cfr-earth-500">Non-Smoking</span>';
      if (accessibility)
        indicators +=
          '<span class="inline-flex items-center gap-1 rounded-full bg-cfr-green-50 px-2 py-0.5 text-[10px] font-medium text-cfr-green-700">Accessible</span>';

      let pricingHtml = "";
      if (available) {
        const hasDiscount = originalRate && originalRate > nightlyRate;
        pricingHtml =
          '<div class="mt-4 space-y-1">' +
          '<div class="flex items-baseline gap-2">' +
          '<span class="text-xl font-bold text-cfr-earth-700">' +
          formatCurrency(nightlyRate) +
          ' <span class="text-sm font-normal text-cfr-earth-400">/ night</span></span>' +
          (hasDiscount
            ? '<span class="text-sm text-cfr-earth-400 line-through">' +
              formatCurrency(originalRate) +
              "</span>"
            : "") +
          "</div>" +
          '<p class="text-sm text-cfr-earth-500">' +
          formatCurrency(totalStay) +
          " for " +
          nights +
          " night" +
          (nights !== 1 ? "s" : "") +
          (hasDiscount && originalTotal
            ? ' <span class="line-through text-cfr-earth-400">' +
              formatCurrency(originalTotal) +
              "</span>"
            : "") +
          (hasDiscount
            ? ' <span class="font-medium text-cfr-green-leaf">Save ' +
              formatCurrency(originalRate * nights - totalStay) +
              "</span>"
            : "") +
          "</p>" +
          "</div>";

        if (taxBreakdown.length > 0 || totalTaxes > 0) {
          pricingHtml +=
            '<div class="mt-2 border-t border-cfr-earth-100 pt-2">';
          taxBreakdown.forEach(function (t) {
            pricingHtml +=
              '<div class="flex justify-between text-xs text-cfr-earth-400"><span>' +
              t.label +
              "</span><span>" +
              formatCurrency(t.amount) +
              "</span></div>";
          });
          if (totalTaxes > 0 && taxBreakdown.length === 0) {
            pricingHtml +=
              '<div class="flex justify-between text-xs text-cfr-earth-400"><span>Taxes</span><span>' +
              formatCurrency(totalTaxes) +
              "</span></div>";
          }
          pricingHtml +=
            '<div class="flex justify-between text-sm font-bold text-cfr-earth-700"><span>Total</span><span>' +
            formatCurrency(grandTotal || totalStay + totalTaxes) +
            "</span></div></div>";
        }
      } else {
        pricingHtml =
          '<div class="mt-4"><p class="text-sm font-medium text-cfr-earth-400">Not available for these dates</p></div>';
      }

      let cancellationHtml = "";
      if (cancellationPolicy) {
        cancellationHtml =
          '<div class="mt-3 flex items-center gap-1.5 text-xs text-cfr-green-leaf">' +
          '<svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>' +
          cancellationPolicy +
          "</div>";
      }

      card.innerHTML =
        imageHtml +
        '<div class="p-5 sm:p-6">' +
        '<div class="flex items-start justify-between gap-3">' +
        '<h3 class="font-display text-lg font-bold text-cfr-green-dark sm:text-xl">' +
        name +
        "</h3>" +
        (available
          ? '<span class="inline-flex items-center gap-1 rounded-full bg-cfr-green-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-cfr-green-700"><svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>Available</span>'
          : '<span class="inline-flex items-center rounded-full bg-cfr-earth-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-cfr-earth-500">Unavailable</span>') +
        "</div>" +
        (description
          ? '<p class="mt-1.5 text-sm leading-relaxed text-cfr-earth-600">' +
            description +
            "</p>"
          : "") +
        (infoChips
          ? '<div class="mt-3 flex flex-wrap gap-1.5">' + infoChips + "</div>"
          : "") +
        pricingHtml +
        amenityHtml +
        (indicators
          ? '<div class="mt-3 flex flex-wrap gap-1.5">' + indicators + "</div>"
          : "") +
        cancellationHtml +
        '<div class="mt-5">' +
        (available
          ? '<button class="flex w-full items-center justify-center gap-2 rounded-lg bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 select-room-btn" data-slug="' +
            apiRoom.slug +
            '" data-room-type="' +
            apiRoom.room_type +
            '">Select This Room</button>'
          : '<button disabled class="flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-lg bg-cfr-earth-200 px-6 py-3 text-sm font-semibold text-cfr-earth-400">Unavailable</button>') +
        "</div>" +
        "</div>";

      return card;
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      searchAvailability();
    });

    retryBtn.addEventListener("click", function () {
      searchAvailability();
    });

    searchAgainBtn.addEventListener("click", function () {
      form.scrollIntoView({ behavior: "smooth", block: "center" });
      checkinInput.focus();
    });

    backToResultsBtn.addEventListener("click", function () {
      showState(stateResults);
      updateUrl("results", {
        checkin: lastSearchParams?.checkin,
        checkout: lastSearchParams?.checkout,
        adults: lastSearchParams?.adults,
        children: lastSearchParams?.children,
      });
    });

    backToGuestsBtn.addEventListener("click", function () {
      showState(stateGuests);
      updateUrl("guests", {
        room: selectedRoom?.slug,
        rt: selectedRoomType || selectedRoom?.slug,
        checkin: lastSearchParams?.checkin,
        checkout: lastSearchParams?.checkout,
        adults: lastSearchParams?.adults,
        children: lastSearchParams?.children,
      });
    });

    proceedToReviewBtn.addEventListener("click", function () {
      if (typeof window.validateGuestForm === "function" && !window.validateGuestForm()) {
        return;
      }
      guestData = typeof window.getGuestDetails === "function" ? window.getGuestDetails() : {};
      persistDraft({
        roomSlug: selectedRoom?.slug,
        roomType: selectedRoomType || null,
        checkin: lastSearchParams?.checkin,
        checkout: lastSearchParams?.checkout,
        adults: lastSearchParams?.adults,
        children: lastSearchParams?.children,
        quote: quoteData || {},
        guest: guestData,
        step: "review",
      });
      showState(stateReview);
      gaTrackOnce(
        "review_booking",
        "review:" + (selectedRoomType || selectedRoom?.slug) + ":" + lastSearchParams?.checkin + ":" + lastSearchParams?.checkout,
        gaParams()
      );
      updateUrl("review", {
        room: selectedRoom?.slug,
        rt: selectedRoomType || selectedRoom?.slug,
        checkin: lastSearchParams?.checkin,
        checkout: lastSearchParams?.checkout,
        adults: lastSearchParams?.adults,
        children: lastSearchParams?.children,
      });
    });

    tryBookingAgainBtn.addEventListener("click", function () {
      showState(stateReview);
    });

    const backToReviewBtn = document.getElementById("back-to-review");
    if (backToReviewBtn) {
      backToReviewBtn.addEventListener("click", function () {
        stopCountdown();
        showCountdown(false);
        showState(stateReview);
        updateUrl("review", {
          room: selectedRoom?.slug,
          rt: selectedRoomType || selectedRoom?.slug,
          checkin: lastSearchParams?.checkin,
          checkout: lastSearchParams?.checkout,
          adults: lastSearchParams?.adults,
          children: lastSearchParams?.children,
        });
      });
    }

    const searchAgainExpiredBtn = document.getElementById("search-again-expired");
    if (searchAgainExpiredBtn) {
      searchAgainExpiredBtn.addEventListener("click", function () {
        clearBookingSession();
        showState(stateInitial);
        form.scrollIntoView({ behavior: "smooth", block: "center" });
        checkinInput.focus();
      });
    }

    document.addEventListener("click", function (e) {
      const target = e.target;
      if (target.classList.contains("select-room-btn")) {
        const slug = target.getAttribute("data-slug");
        const roomType = target.getAttribute("data-room-type");
        if (slug) {
          const roomContent = resolveRoomContent(slug, ROOM_CONTENT);
          const roomName =
            roomContent === DEFAULT_ROOM ? roomType || slug : roomContent.name;
          gaTrack("select_room", {
            room_name: roomName,
            room_type: roomType || slug,
            check_in: lastSearchParams ? lastSearchParams.checkin : null,
            check_out: lastSearchParams ? lastSearchParams.checkout : null,
            guest_count: lastSearchParams
              ? (lastSearchParams.adults || 0) + (lastSearchParams.children || 0)
              : null,
            currency: "INR",
            property_name: GA_PROPERTY,
          });
          fetchQuote(slug, roomType || slug);
        }
        return;
      }
      const actionBtn = target.closest ? target.closest("[data-action]") : null;
      if (actionBtn) {
        const action = actionBtn.getAttribute("data-action");
        if (action === "back-to-guests") {
          showState(stateGuests);
          updateUrl("guests", {
            room: selectedRoom?.slug,
            rt: selectedRoomType || selectedRoom?.slug,
            checkin: lastSearchParams?.checkin,
            checkout: lastSearchParams?.checkout,
            adults: lastSearchParams?.adults,
            children: lastSearchParams?.children,
          });
        }
      }
    });

    const completeBookingBtns = document.querySelectorAll("#complete-booking-btn, #mobile-complete-booking-btn");
    completeBookingBtns.forEach((btn) => {
      btn.addEventListener("click", function (e) {
        e.preventDefault();
        submitBooking();
      });
    });

    var payNowBtn = document.getElementById("pay-now-btn");
    if (payNowBtn) {
      payNowBtn.addEventListener("click", function (e) {
        e.preventDefault();
        processRazorpayPayment();
      });
    }

    checkinInput.addEventListener("change", function () {
      if (checkinInput.value) {
        const nextDay = new Date(checkinInput.value + "T00:00:00");
        nextDay.setDate(nextDay.getDate() + 1);
        checkoutInput.min = formatDateValue(nextDay);
        if (checkoutInput.value && checkoutInput.value <= checkinInput.value) {
          checkoutInput.value = formatDateValue(nextDay);
        }
      }
    });

    setDefaultDates();
    initLightbox();

    window.addEventListener("popstate", function () {
      restoreStepFromUrl(true);
    });

    restoreStepFromUrl(false);
  })();
</script>
