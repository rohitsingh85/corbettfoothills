    function initRoomCarousel(root, name) {
      var track = root.querySelector(".cfr-carousel__track");
      var prevBtn = root.querySelector("[data-carousel-prev]");
      var nextBtn = root.querySelector("[data-carousel-next]");
      var dots = Array.prototype.slice.call(root.querySelectorAll("[data-dot]"));
      var slides = Array.prototype.slice.call(track.children);
      var slideBtns = slides.map(function (s) { return s.querySelector("[data-slide-btn]"); });
      var imgs = slides.map(function (s) { return s.querySelector("img"); });
      var live = root.querySelector("[data-carousel-live]");
      var cardEl = root.closest("article");
      var thumbsEl = cardEl ? cardEl.querySelector("[data-thumbs]") : null;
      var thumbs = thumbsEl
        ? Array.prototype.slice.call(thumbsEl.querySelectorAll("[data-thumb]"))
        : [];
      var total = dots.length;
      var pos = 1;
      var isAnimating = false;
      var animTimer = null;
      var suppressClick = false;
      var pointer = { down: false, startX: 0, deltaX: 0, dragging: false };

