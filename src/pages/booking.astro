        if (animTimer) {
          clearTimeout(animTimer);
          animTimer = null;
        }
        snapToReal();
        revealThumb(((pos - 1) % total + total) % total);
      }

      function beginMove() {
        isAnimating = true;
        if (animTimer) clearTimeout(animTimer);
        animTimer = setTimeout(finishMove, 700);
      }

      function snapToReal() {
