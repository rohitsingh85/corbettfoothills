        thumbs.forEach(function (t, i) {
          t.classList.toggle("is-active", i === real);
          if (i === real) t.setAttribute("aria-current", "true");
          else t.removeAttribute("aria-current");
        });
        var neighbors = [real, (real + 1) % total, ((real - 1 + total) % total)];
        slides.forEach(function (s, i) {
          var realIdx = ((i - 1) % total + total) % total;
          if (neighbors.indexOf(realIdx) === -1) return;
          var img = imgs[i];
          if (img && !img.getAttribute("src") && img.getAttribute("data-src")) {
            img.setAttribute("src", img.getAttribute("data-src"));
          }
        });
