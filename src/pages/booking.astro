      nextBtn.addEventListener("click", function (e) { e.preventDefault(); next(); });
      dots.forEach(function (d, i) {
        d.addEventListener("click", function (e) { e.preventDefault(); goTo(i); });
      });
      thumbs.forEach(function (t, i) {
        t.addEventListener("click", function (e) { e.preventDefault(); goTo(i); });
