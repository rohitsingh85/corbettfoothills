<script define:vars={{ roomsJson, roomMappingJson, defaultRoomJson, isDev }}>
  (function () {
    const ROOM_CONTENT = JSON.parse(roomsJson);
    const ROOM_MAPPING = JSON.parse(roomMappingJson);
    const DEFAULT_ROOM = JSON.parse(defaultRoomJson);

    const SLUG_TO_ROOM_TYPE = {};
    for (const pmsType in ROOM_MAPPING) {
      SLUG_TO_ROOM_TYPE[ROOM_MAPPING[pmsType]] = pmsType;
    }

    function normalizeRoomKey(k) {
      return String(k || "")
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9]/g, "");
    }

    function resolveRoomContent(identifier, contentList) {
      const key = normalizeRoomKey(identifier);
      if (!key) return DEFAULT_ROOM;
      const direct = contentList.find((r) => normalizeRoomKey(r.slug) === key);
      if (direct) return direct;
      for (const pmsType in ROOM_MAPPING) {
        if (normalizeRoomKey(pmsType) === key) {
          const mapped = contentList.find(
            (r) => normalizeRoomKey(r.slug) === normalizeRoomKey(ROOM_MAPPING[pmsType])
          );
          if (mapped) return mapped;
        }
      }
      if (isDev) {
        console.warn("[roomMapping] Unknown room: " + identifier + " — using default content");
      }
      return DEFAULT_ROOM;
    }

    const BFF_BASE = "/api/booking";
    const TIMEOUT_MS = 15000;
    const GA_PROPERTY = "Corbett Foothills Retreat";

    function gaParams(extra) {
      const params = {
        room_name: selectedRoom ? selectedRoom.name : null,
        room_type: selectedRoomType || (selectedRoom ? selectedRoom.slug : null),
        check_in: lastSearchParams ? lastSearchParams.checkin : null,
        check_out: lastSearchParams ? lastSearchParams.checkout : null,
        guest_count: lastSearchParams
          ? (lastSearchParams.adults || 0) + (lastSearchParams.children || 0)
          : null,
        booking_value: quoteData && quoteData.total ? quoteData.total : null,
        currency: (quoteData && quoteData.currency) || "INR",
        property_name: GA_PROPERTY,
      };
      return extra ? Object.assign(params, extra) : params;
    }

    function gaTrack(name, params) {
      if (window.CFR_ANALYTICS) window.CFR_ANALYTICS.track(name, params || {});
    }

    function gaTrackOnce(name, token, params) {
      if (window.CFR_ANALYTICS)
        window.CFR_ANALYTICS.trackOnce(name, token, params || {});
    }

    const form = document.getElementById("search-form");
    const checkinInput = document.getElementById("checkin");
    const checkoutInput = document.getElementById("checkout");
    const adultsInput = document.getElementById("adults");
    const childrenInput = document.getElementById("children");
    const searchBtn = document.getElementById("search-btn");
    const searchBtnText = document.getElementById("search-btn-text");
    const searchIcon = document.getElementById("search-icon");
    const searchSpinner = document.getElementById("search-spinner");
    const retryBtn = document.getElementById("retry-btn");
    const searchAgainBtn = document.getElementById("search-again-btn");
    const backToResultsBtn = document.getElementById("back-to-results");
    const backToGuestsBtn = document.getElementById("back-to-guests");
    const proceedToReviewBtn = document.getElementById("proceed-to-review");
    const tryBookingAgainBtn = document.getElementById("try-booking-again");

    const stateInitial = document.getElementById("state-initial");
    const stateLoading = document.getElementById("state-loading");
    const stateError = document.getElementById("state-error");
    const stateEmpty = document.getElementById("state-empty");
    const stateResults = document.getElementById("state-results");
    const stateGuests = document.getElementById("state-guests");
    const stateReview = document.getElementById("state-review");
    const stateBookingError = document.getElementById("state-booking-error");
    const statePayment = document.getElementById("state-payment");
    const stateSessionExpired = document.getElementById("state-session-expired");
    const errorMessage = document.getElementById("error-message");
    const bookingErrorMessage = document.getElementById("booking-error-message");
    const resultsSummary = document.getElementById("results-summary");
    const roomsGrid = document.getElementById("rooms-grid");
    const searchSection = document.getElementById("search-section");
    const mobileBookingBar = document.getElementById("mobile-booking-bar");

    let currentAbortController = null;
    let lastSearchParams = null;
    let selectedRoom = null;
    let selectedRoomType = null;
    let quoteData = null;
    let guestData = null;

    const SESSION_DURATION_MS = 300000;
    const SESSION_WARNING_MS = 120000;
    const SESSION_URGENT_MS = 60000;
    const SESSION_STORAGE_KEY = "cfr_booking_session";
    const DRAFT_STORAGE_KEY = "cfr_booking_draft";
    let sessionData = null;
    let countdownInterval = null;
    let serverTimeOffset = 0;

    function getUrlParams() {
      const params = new URLSearchParams(window.location.search);
      return {
        step: params.get("step") || "search",
        room: params.get("room") || "",
        rt: params.get("rt") || "",
        checkin: params.get("checkin") || "",
        checkout: params.get("checkout") || "",
        adults: parseInt(params.get("adults") || "2", 10),
        children: parseInt(params.get("children") || "0", 10),
      };
    }

    function updateUrl(step, params = {}) {
      const url = new URL(window.location);
      url.searchParams.set("step", step);
      Object.entries(params).forEach(([key, value]) => {
        if (value !== undefined && value !== null && value !== "") {
          url.searchParams.set(key, String(value));
        }
      });
      window.history.pushState({}, "", url);
    }

    function setDefaultDates() {
      const now = new Date();
      const tomorrow = new Date(now);
      tomorrow.setDate(tomorrow.getDate() + 1);
      const dayAfter = new Date(now);
      dayAfter.setDate(dayAfter.getDate() + 2);

      checkinInput.value = formatDateValue(tomorrow);
      checkoutInput.value = formatDateValue(dayAfter);
      checkinInput.min = formatDateValue(now);
    }

    function formatDateValue(d) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, "0");
      const day = String(d.getDate()).padStart(2, "0");
      return y + "-" + m + "-" + day;
    }

    function formatDisplayDate(dateStr) {
      const d = new Date(dateStr + "T00:00:00");
      return d.toLocaleDateString("en-IN", {
        month: "short",
        day: "numeric",
        year: "numeric",
      });
    }

    function formatCurrency(amount) {
      return new Intl.NumberFormat("en-IN", {
        style: "currency",
        currency: "INR",
        maximumFractionDigits: 0,
      }).format(amount);
    }

    function showState(state) {
      [stateInitial, stateLoading, stateError, stateEmpty, stateResults, stateGuests, stateReview, stateBookingError, statePayment, stateSessionExpired].forEach(
        (el) => el.classList.add("hidden")
      );
      state.classList.remove("hidden");

      if (mobileBookingBar) {
        if (state === stateReview) {
          mobileBookingBar.classList.remove("hidden");
        } else {
          mobileBookingBar.classList.add("hidden");
        }
      }

      if (state === statePayment) {
        showCountdown(true);
      } else {
        showCountdown(false);
      }

      if (state === stateGuests) {
        populateGuestForm();
      }

      if (quoteData && selectedRoom && lastSearchParams) {
        renderBookingState();
      }
    }

    function populateGuestForm() {
      var g = guestData || {};
      var firstName = document.getElementById("guest-firstName");
      var lastName = document.getElementById("guest-lastName");
      var email = document.getElementById("guest-email");
      var phone = document.getElementById("guest-phone");
      var country = document.getElementById("guest-country");
      var specialRequests = document.getElementById("guest-specialRequests");
      if (firstName && g.firstName) firstName.value = g.firstName;
      if (lastName && g.lastName) lastName.value = g.lastName;
      if (email && g.email) email.value = g.email;
      if (phone && g.phone) phone.value = g.phone;
      if (country && g.country) country.value = g.country;
      if (specialRequests && g.specialRequests) {
        specialRequests.value = g.specialRequests;
        var countEl = document.getElementById("specialRequests-count");
        if (countEl) countEl.textContent = String(specialRequests.value.length);
      }
    }

    function setLoading(loading) {
      if (loading) {
        searchBtn.disabled = true;
        searchBtnText.textContent = "Searching\u2026";
        searchIcon.classList.add("hidden");
        searchSpinner.classList.remove("hidden");
      } else {
        searchBtn.disabled = false;
        searchBtnText.textContent = "Check Availability";
        searchIcon.classList.remove("hidden");
        searchSpinner.classList.add("hidden");
      }
    }

    function clearErrors() {
      document.querySelectorAll("[id$=-error]").forEach((el) => {
        el.classList.add("hidden");
        el.textContent = "";
      });
      document.querySelectorAll("input, select").forEach((el) => {
        el.classList.remove("!border-red-500");
      });
    }

    function showError(fieldId, message) {
      const errorEl = document.getElementById(fieldId + "-error");
      const inputEl = document.getElementById(fieldId);
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
      }
      if (inputEl) {
        inputEl.classList.add("!border-red-500");
      }
    }

    function generateSessionId() {
      const arr = new Uint8Array(16);
      crypto.getRandomValues(arr);
      return Array.from(arr, function (b) { return b.toString(16).padStart(2, "0"); }).join("");
    }

    function persistSession(session) {
      try {
        sessionStorage.setItem(SESSION_STORAGE_KEY, JSON.stringify(session));
      } catch (e) { /* ignore */ }
    }

    function loadSession() {
      try {
        var raw = sessionStorage.getItem(SESSION_STORAGE_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed.sessionId || !parsed.expiresAt) return null;
        return parsed;
      } catch (e) {
        return null;
      }
    }

    function clearBookingSession() {
      try {
        sessionStorage.removeItem(SESSION_STORAGE_KEY);
      } catch (e) { /* ignore */ }
      sessionData = null;
      stopCountdown();
    }

    function persistDraft(patch) {
      try {
        var draft = Object.assign({}, loadDraft(), patch);
        sessionStorage.setItem(DRAFT_STORAGE_KEY, JSON.stringify(draft));
      } catch (e) { /* ignore */ }
    }

    function loadDraft() {
      try {
        var raw = sessionStorage.getItem(DRAFT_STORAGE_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed.roomSlug || !parsed.checkin || !parsed.checkout) return null;
        return parsed;
      } catch (e) {
        return null;
      }
    }

    function clearDraft() {
      try {
        sessionStorage.removeItem(DRAFT_STORAGE_KEY);
      } catch (e) { /* ignore */ }
    }

    function isSessionExpired(session) {
      return Date.now() >= session.expiresAt;
    }

    function getRemainingMs(session) {
      return Math.max(0, session.expiresAt - Date.now());
    }

    function formatTimeRemaining(ms) {
      if (ms <= 0) return "0:00";
      var totalSec = Math.ceil(ms / 1000);
      var min = Math.floor(totalSec / 60);
      var sec = totalSec % 60;
      return min + ":" + String(sec).padStart(2, "0");
    }

    function updateCountdownDisplay() {
      if (!sessionData) return;
      var remaining = getRemainingMs(sessionData);
      var timeEl = document.getElementById("countdown-time");
      var progressEl = document.getElementById("countdown-progress");
      var countdownEl = document.getElementById("session-countdown");
      var srAnnounce = document.getElementById("countdown-sr-announce");

      if (timeEl) timeEl.textContent = formatTimeRemaining(remaining);

      if (progressEl) {
        var pct = Math.max(0, (remaining / SESSION_DURATION_MS) * 100);
        progressEl.style.width = pct + "%";
      }

      if (countdownEl) {
        countdownEl.classList.remove("countdown-state-warning", "countdown-state-urgent");
        if (remaining <= SESSION_URGENT_MS && remaining > 0) {
          countdownEl.classList.add("countdown-state-urgent");
        } else if (remaining <= SESSION_WARNING_MS && remaining > 0) {
          countdownEl.classList.add("countdown-state-warning");
        }
      }

      if (srAnnounce && remaining > 0 && remaining % 30000 < 1100) {
        var mins = Math.ceil(remaining / 60000);
        srAnnounce.textContent = mins + " minute" + (mins !== 1 ? "s" : "") + " remaining";
      }

      if (remaining <= 0) {
        onSessionExpired();
      }
    }

    function startCountdown() {
      stopCountdown();
      updateCountdownDisplay();
      countdownInterval = setInterval(updateCountdownDisplay, 1000);
    }

    function stopCountdown() {
      if (countdownInterval) {
        clearInterval(countdownInterval);
        countdownInterval = null;
      }
    }

    function onSessionExpired() {
      stopCountdown();
      clearBookingSession();
      showState(stateSessionExpired);
      updateUrl("expired", {
        room: selectedRoom?.slug,
        rt: selectedRoomType || selectedRoom?.slug,
        checkin: lastSearchParams?.checkin,
        checkout: lastSearchParams?.checkout,
      });
    }

    function showCountdown(show) {
      var el = document.getElementById("session-countdown");
      if (el) {
        if (show) {
          el.classList.remove("hidden");
        } else {
          el.classList.add("hidden");
        }
      }
    }

    function loadRazorpayScript() {
      return new Promise(function (resolve, reject) {
        if (window.Razorpay) {
          resolve();
          return;
        }
        var script = document.createElement("script");
        script.src = "https://checkout.razorpay.com/v1/checkout.js";
        script.async = true;
        script.defer = true;
        script.onload = resolve;
        script.onerror = function () { reject(new Error("Failed to load Razorpay SDK")); };
        document.head.appendChild(script);
      });
    }

    async function processRazorpayPayment() {
      if (!selectedRoom || !lastSearchParams || !guestData || !quoteData) return;

      if (sessionData && sessionData.paymentReceived) {
        showState(stateBookingError);
        if (document.getElementById("booking-error-message")) {
          document.getElementById("booking-error-message").textContent =
            "Your payment was received but could not be confirmed. Please contact support to complete your booking.";
        }
        return;
      }

      var payBtn = document.getElementById("pay-now-btn");
      var payText = document.getElementById("pay-now-text");
      var paySpinner = document.getElementById("pay-now-spinner");
      var errorEl = document.getElementById("razorpay-error");

      if (payBtn) payBtn.disabled = true;
      if (payText) payText.textContent = "Creating order…";
      if (paySpinner) paySpinner.classList.remove("hidden");
      if (errorEl) { errorEl.classList.add("hidden"); errorEl.textContent = ""; }

      try {
        await loadRazorpayScript();

        var submitRes = await fetch("/api/booking/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            room_id: selectedRoomType || selectedRoom.slug,
            checkin: lastSearchParams.checkin,
            checkout: lastSearchParams.checkout,
            adults: lastSearchParams.adults,
            children: lastSearchParams.children || 0,
            guest: guestData,
            quote_id: quoteData.quote_id || null,
          }),
        });

        var submitData = await submitRes.json();

        if (!submitRes.ok || !submitData.success) {
          throw new Error(submitData.error || "Failed to create booking order");
        }

        var amountInr = Math.round(Number(submitData.amount || 0) / 100);
        gaTrack(
          "payment_started",
          gaParams({
            booking_value:
              amountInr || (quoteData && quoteData.total ? quoteData.total : null),
            currency: submitData.currency || "INR",
          })
        );

        var options = {
          key: submitData.razorpay_key_id,
          amount: submitData.amount,
          currency: submitData.currency || "INR",
          order_id: submitData.razorpay_order_id,
          name: "Corbett Foothills Retreat",
          description: selectedRoom.name + " — " + formatDisplayDate(lastSearchParams.checkin) + " to " + formatDisplayDate(lastSearchParams.checkout),
          prefill: {
            name: guestData.firstName + " " + guestData.lastName,
            email: guestData.email,
            contact: guestData.phone,
          },
          theme: { color: "#1a4a3f" },
          modal: {
            ondismiss: function () {
              gaTrack("payment_failed", gaParams({ reason: "cancelled" }));
              if (payBtn) payBtn.disabled = false;
              if (payText) payText.textContent = "Pay Now";
              if (paySpinner) paySpinner.classList.add("hidden");
              if (errorEl) {
                errorEl.textContent = "Payment was cancelled. You can try again.";
                errorEl.classList.remove("hidden");
              }
            },
          },
          handler: async function (response) {
            if (response.error || !response.razorpay_payment_id) {
              gaTrack("payment_failed", gaParams({ reason: "error" }));
              if (payBtn) payBtn.disabled = false;
              if (payText) payText.textContent = "Pay Now";
              if (paySpinner) paySpinner.classList.add("hidden");
              if (errorEl) {
                errorEl.textContent = response.error?.description || "Payment failed. Please try again.";
                errorEl.classList.remove("hidden");
              }
              return;
            }

            if (sessionData) {
              sessionData.paymentReceived = true;
              persistSession(sessionData);
            }

            if (payBtn) payBtn.disabled = true;
            if (payText) payText.textContent = "Verifying payment…";
            if (paySpinner) paySpinner.classList.remove("hidden");

            try {
              var verifyRes = await fetch("/api/booking/verify-payment", {
                method: "POST",
                headers: { "Content-Type": "application/json", Accept: "application/json" },
                body: JSON.stringify({
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_order_id: response.razorpay_order_id,
                  razorpay_signature: response.razorpay_signature,
                }),
              });

              var verifyData = await verifyRes.json();

              if (!verifyRes.ok || !verifyData.verified) {
                throw new Error(verifyData.error || "Payment verification failed");
              }

              if (sessionData) {
                sessionData.paymentStatus = "completed";
                persistSession(sessionData);
              }

              gaTrackOnce(
                "payment_success",
                response.razorpay_payment_id,
                gaParams({
                  booking_value: Math.round(Number(submitData.amount || 0) / 100),
                  currency: submitData.currency || "INR",
                })
              );

              var params = new URLSearchParams({
                booking_id: submitData.booking_id || "",
                payment_id: response.razorpay_payment_id,
                status: "confirmed",
                room_name: selectedRoom.name || "",
                room_type: selectedRoomType || selectedRoom.slug || "",
                check_in: lastSearchParams ? lastSearchParams.checkin : "",
                check_out: lastSearchParams ? lastSearchParams.checkout : "",
                guest_count: lastSearchParams
                  ? String((lastSearchParams.adults || 0) + (lastSearchParams.children || 0))
                  : "",
                booking_value: String(amountInr || ""),
                currency: submitData.currency || "INR",
              });
              window.location.href = "/booking/confirmation?" + params.toString();
            } catch (verifyErr) {
              gaTrack("payment_failed", gaParams({ reason: "verification_failed" }));
              if (payBtn) payBtn.disabled = false;
              if (payText) payText.textContent = "Pay Now";
              if (paySpinner) paySpinner.classList.add("hidden");
              if (errorEl) {
                errorEl.textContent = "Payment received but could not be verified. Please contact support with your booking ID: " + (submitData.booking_id || "unknown");
                errorEl.classList.remove("hidden");
              }
            }
          },
        };

        var rzp = new Razorpay(options);
        rzp.open();
      } catch (err) {
        if (payBtn) payBtn.disabled = false;
        if (payText) payText.textContent = "Pay Now";
        if (paySpinner) paySpinner.classList.add("hidden");
        if (errorEl) {
          errorEl.textContent = err.message || "Something went wrong. Please try again.";
          errorEl.classList.remove("hidden");
        }
      }
    }

    async function fetchServerTime() {
      try {
        var res = await fetch("/api/booking/session", {
          method: "GET",
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          var data = await res.json();
          serverTimeOffset = (data.serverTime || Date.now()) - Date.now();
        }
      } catch (e) { /* ignore */ }
    }

    function createBookingSession(roomSlug, roomName, checkin, checkout, adults, children, quote, guest, quoteId, roomType) {
      var now = Date.now();
      var session = {
        sessionId: generateSessionId(),
        createdAt: now,
        expiresAt: now + SESSION_DURATION_MS,
        serverTimeAtCreate: now,
        roomSlug: roomSlug,
        roomName: roomName,
        roomType: roomType,
        checkin: checkin,
        checkout: checkout,
        adults: adults,
        children: children,
        quoteId: quoteId || null,
        guest: guest || {},
        quote: quote || {},
        paymentMethod: null,
        paymentStatus: "pending",
        currentStep: "payment",
      };
      sessionData = session;
      persistSession(session);
      return session;
    }

    function setupNavigationProtection() {
      window.addEventListener("beforeunload", function (e) {
        if (sessionData && !isSessionExpired(sessionData) && sessionData.paymentStatus !== "completed") {
          e.preventDefault();
          e.returnValue = "";
          return "";
        }
      });
    }

    function attemptSessionRecovery() {
      var saved = loadSession();
      if (saved && !isSessionExpired(saved)) {
        sessionData = saved;
        selectedRoom = resolveRoomContent(saved.roomSlug, ROOM_CONTENT);
        selectedRoomType = saved.roomType || SLUG_TO_ROOM_TYPE[saved.roomSlug] || null;
        lastSearchParams = {
          checkin: saved.checkin,
          checkout: saved.checkout,
          adults: saved.adults,
          children: saved.children,
        };
        quoteData = saved.quote;
        guestData = saved.guest;
        showState(statePayment);
        showCountdown(true);
        startCountdown();
        return true;
      }
      if (saved && isSessionExpired(saved)) {
        clearBookingSession();
      }
      return false;
    }

    function hydrateFromSource(source) {
      if (!source) return;
      selectedRoom = resolveRoomContent(source.roomSlug, ROOM_CONTENT);
      if (selectedRoom === DEFAULT_ROOM) {
        selectedRoom = Object.assign({}, selectedRoom, { name: source.roomType || source.roomSlug });
      }
      selectedRoomType = source.roomType || SLUG_TO_ROOM_TYPE[source.roomSlug] || null;
      lastSearchParams = {
        checkin: source.checkin,
        checkout: source.checkout,
        adults: source.adults,
        children: source.children || 0,
      };
      quoteData = source.quote || null;
      guestData = source.guest || {};
    }

    function restoreStepFromUrl(navigating) {
      var urlParams = getUrlParams();
      var step = urlParams.step || "search";

      if (step === "search" || step === "expired") {
        if (step === "expired") {
          showState(stateSessionExpired);
        } else {
          showState(stateInitial);
        }
        return;
      }

      if (step === "results") {
        if (roomsGrid.children.length > 0) {
          showState(stateResults);
        } else if (urlParams.checkin) {
          checkinInput.value = urlParams.checkin;
          checkoutInput.value = urlParams.checkout;
          adultsInput.value = String(urlParams.adults || 2);
          childrenInput.value = String(urlParams.children || 0);
          searchAvailability();
        }
        return;
      }

      if (step === "guests" || step === "review") {
        var source = loadDraft();
        if (!source) {
          var saved = loadSession();
          if (saved && !isSessionExpired(saved)) {
            source = saved;
          }
        }
        if (source) {
          hydrateFromSource(source);
          if (step === "guests" || !(guestData && (guestData.firstName || guestData.email || guestData.phone))) {
            showState(stateGuests);
          } else {
            showState(stateReview);
          }
        } else if (urlParams.room) {
          var roomSlug = urlParams.room;
          selectedRoom = resolveRoomContent(roomSlug, ROOM_CONTENT);
          selectedRoomType = urlParams.rt || SLUG_TO_ROOM_TYPE[roomSlug] || null;
          lastSearchParams = {
            checkin: urlParams.checkin,
            checkout: urlParams.checkout,
            adults: urlParams.adults,
            children: urlParams.children,
          };
          fetchQuote(roomSlug, selectedRoomType);
        }
        return;
      }

      if (step === "payment") {
        var session = loadSession();
        if (session && !isSessionExpired(session)) {
          attemptSessionRecovery();
        } else {
          showState(stateInitial);
        }
        return;
      }
    }

    function validate() {
      clearErrors();
      let valid = true;

      const checkin = checkinInput.value;
      const checkout = checkoutInput.value;
      const adults = parseInt(adultsInput.value, 10);
      const today = formatDateValue(new Date());

      if (!checkin) {
        showError("checkin", "Please select a check-in date");
        valid = false;
      } else if (checkin < today) {
        showError("checkin", "Check-in cannot be in the past");
        valid = false;
      }

      if (!checkout) {
        showError("checkout", "Please select a check-out date");
        valid = false;
      } else if (checkin && checkout <= checkin) {
        showError("checkout", "Check-out must be after check-in");
        valid = false;
      }

      if (!adults || adults < 1) {
        showError("adults", "At least 1 adult is required");
        valid = false;
      }

      return valid;
    }

    async function searchAvailability() {
      if (!validate()) return;

      const params = {
        checkin: checkinInput.value,
        checkout: checkoutInput.value,
        adults: parseInt(adultsInput.value, 10),
        children: parseInt(childrenInput.value, 10) || 0,
      };

      lastSearchParams = params;

      gaTrack("search_availability", {
        check_in: params.checkin,
        check_out: params.checkout,
        guest_count: params.adults + (params.children || 0),
        currency: "INR",
        property_name: GA_PROPERTY,
      });

      if (currentAbortController) currentAbortController.abort();
      currentAbortController = new AbortController();

      showState(stateLoading);
      setLoading(true);

      try {
        const url =
          BFF_BASE +
          "/availability?" +
          new URLSearchParams({
            checkin: params.checkin,
            checkout: params.checkout,
            adults: String(params.adults),
            children: String(params.children),
          }).toString();

        const response = await fetch(url, {
          method: "GET",
          headers: {
            Accept: "application/json",
          },
          signal: currentAbortController.signal,
        });

        if (!response.ok) {
          throw { message: "Server error", code: "SERVER_ERROR" };
        }

        const data = await response.json();

        if (!data.rooms || data.rooms.length === 0) {
          gaTrackOnce(
            "availability_results",
            "avail:" + params.checkin + ":" + params.checkout + ":" + params.adults + ":" + (params.children || 0),
            {
              room_count: 0,
              check_in: params.checkin,
              check_out: params.checkout,
              guest_count: params.adults + (params.children || 0),
              currency: "INR",
              property_name: GA_PROPERTY,
            }
          );
          showState(stateEmpty);
          return;
        }

        renderResults(data);
        gaTrackOnce(
          "availability_results",
          "avail:" + params.checkin + ":" + params.checkout + ":" + params.adults + ":" + (params.children || 0),
          {
            room_count: data.rooms.length,
            check_in: params.checkin,
            check_out: params.checkout,
            guest_count: params.adults + (params.children || 0),
            currency: "INR",
            property_name: GA_PROPERTY,
          }
        );
        showState(stateResults);
        updateUrl("results", {
          checkin: params.checkin,
          checkout: params.checkout,
          adults: params.adults,
          children: params.children,
        });
        scrollResultsIntoView();
      } catch (err) {
        if (err?.name === "AbortError") return;
        showState(stateError);
        errorMessage.textContent =
          err?.message || "Something went wrong. Please try again.";
      } finally {
        setLoading(false);
      }
    }

    async function fetchQuote(roomSlug, roomType) {
      const room = resolveRoomContent(roomSlug, ROOM_CONTENT);
      if (!lastSearchParams) return;

      selectedRoom =
        room === DEFAULT_ROOM ? Object.assign({}, room, { name: roomType || roomSlug }) : room;
      selectedRoomType = roomType || null;

      const stateLoading = document.createElement("div");
      stateLoading.id = "quote-loading";
      stateLoading.className = "fixed inset-0 z-50 flex items-center justify-center bg-black/50";
      stateLoading.innerHTML = `
        <div class="rounded-2xl bg-white p-6 text-center shadow-premium">
          <svg class="mx-auto h-8 w-8 animate-spin text-cfr-green-accent" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <p class="mt-3 text-sm font-medium text-cfr-earth-600">Calculating your rate...</p>
        </div>
      `;
      document.body.appendChild(stateLoading);

      try {
        const response = await fetch(BFF_BASE + "/quote", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify({
            room_id: roomType || roomSlug,
            checkin: lastSearchParams.checkin,
            checkout: lastSearchParams.checkout,
            adults: lastSearchParams.adults,
            children: lastSearchParams.children,
          }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Failed to get quote");
        }

        quoteData = data;
        persistDraft({
          roomSlug: roomSlug,
          roomType: roomType || null,
          checkin: lastSearchParams.checkin,
          checkout: lastSearchParams.checkout,
          adults: lastSearchParams.adults,
          children: lastSearchParams.children,
          quote: data,
          guest: guestData || {},
          step: "guests",
        });
        showState(stateGuests);
        gaTrackOnce(
          "enter_guest_details",
          "guests:" + (selectedRoomType || roomSlug) + ":" + lastSearchParams.checkin + ":" + lastSearchParams.checkout,
          gaParams()
        );
        updateUrl("guests", {
          room: roomSlug,
          rt: roomType || roomSlug,
          checkin: lastSearchParams.checkin,
          checkout: lastSearchParams.checkout,
          adults: lastSearchParams.adults,
          children: lastSearchParams.children,
        });
      } catch (err) {
        console.error("Quote error:", err);
        alert("Unable to get pricing. Please try again.");
      } finally {
        stateLoading.remove();
      }
    }

    function esc(s) {
      return String(s == null ? "" : s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function buildPricingRowsHtml(nights) {
      var taxes = [];
      if (Array.isArray(quoteData.taxBreakdown)) {
        taxes = quoteData.taxBreakdown;
      } else if (quoteData.totalTaxes > 0) {
        taxes = [{ label: "Taxes", amount: quoteData.totalTaxes }];
      }

      var rows =
        '<div class="flex justify-between text-sm">' +
        '<span class="text-cfr-earth-600">Room (' +
        nights +
        " night" +
        (nights !== 1 ? "s" : "") +
        ")</span>" +
        '<span class="font-medium text-cfr-earth-700">' +
        formatCurrency(quoteData.subtotal || quoteData.total || 0) +
        "</span></div>";

      taxes.forEach(function (t) {
        rows +=
          '<div class="flex justify-between text-xs text-cfr-earth-500">' +
          "<span>" +
          esc(t.label) +
          "</span><span>" +
          formatCurrency(t.amount) +
          "</span></div>";
      });

      rows +=
        '<div class="mt-1 flex justify-between border-t border-cfr-earth-100 pt-2">' +
