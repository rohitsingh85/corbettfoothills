        var left = t.offsetLeft - 0.5 * (thumbsEl.clientWidth - t.offsetWidth);
        var max = thumbsEl.scrollWidth - thumbsEl.clientWidth;
        thumbsEl.scrollLeft = Math.max(0, Math.min(left, max));
