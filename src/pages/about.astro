---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import siteData from "../data/site.json";

const ecoIcons = {
  home: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
  recycle: "M4 7v6m0 0h6m-6 0l2.293-2.293A8 8 0 1118 13.5M16 17v-6m0 6h-6m6 0l-2.293 2.293A8 8 0 016 10.5",
  sun: "M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z",
  leaf: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
  water: "M12 2C8.5 6.5 6 10 6 14a6 6 0 1012 0c0-4-2.5-7.5-6-12z",
  heart: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
};
---

<MainLayout title="About Us" description="Learn about Corbett Foothills Retreat — a boutique farmstay sanctuary at the edge of Jim Corbett National Park with six exclusive suites, organic farming, and personalized hospitality.">
  <Fragment slot="header">
    <Header />
  </Fragment>

  <section class="relative flex min-h-[50vh] items-end overflow-hidden bg-cfr-green-dark pt-24">
    <div class="absolute inset-0 bg-hero-pattern"></div>
    <div class="absolute inset-0 bg-leaf-pattern opacity-30"></div>
    <div class="relative mx-auto w-full max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 lg:pb-16">
      <div class="max-w-3xl">
        <a href="/" class="inline-flex items-center gap-1 text-xs uppercase tracking-widest text-sand-300 hover:text-white transition-colors mb-4">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Back to Home
        </a>
        <h1 class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
          About Us
        </h1>
        <p class="mt-4 max-w-xl text-lg text-white">
          {siteData.about.tagline}
        </p>
      </div>
    </div>
  </section>

  <section class="bg-cream-dark py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {
          siteData.about.paragraphs.map((p, index) => (
            <div class={index % 2 === 1 ? "rounded-2xl bg-white/80 p-8 shadow-premium md:p-10" : ""}>
              <p class="text-base leading-relaxed text-earth-700 md:text-lg">{p}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-12 aspect-[16/6] overflow-hidden rounded-2xl">
        <img
          src={siteData.images.hero[0]}
          alt="Corbett Foothills Retreat property view"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="bg-cfr-green-dark py-20 sm:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="font-display text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
          Luxury Deep Within the Jungle
        </h2>
        <p class="mt-4 text-lg text-white">
          Our eco-conscious philosophy is rooted in respect for the land. Every practice at Corbett Foothills Retreat is designed to preserve the natural beauty that surrounds us while offering guests an authentic, responsible luxury experience.
        </p>
      </div>
      <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          siteData.about.ecoPractices.map((practice) => (
            <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-all duration-300 hover:bg-white/10 hover:-translate-y-1">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-cfr-green-accent/20">
                <svg class="h-6 w-6 text-sand-300" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d={ecoIcons[practice.icon] || ecoIcons.leaf} />
                </svg>
              </div>
              <h3 class="mt-4 font-display text-xl font-semibold text-white">{practice.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/80">{practice.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-cream-dark py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 sm:grid-cols-3">
        <div class="rounded-xl bg-white p-6 text-center shadow-card">
          <p class="font-display text-4xl font-bold text-cfr-green-accent">{siteData.accommodationIntro.roomCount}</p>
          <p class="mt-2 text-sm text-earth-600">Exclusive Suites</p>
        </div>
        <div class="rounded-xl bg-white p-6 text-center shadow-card">
          <p class="font-display text-4xl font-bold text-cfr-green-accent">8 km</p>
          <p class="mt-2 text-sm text-earth-600">From Corbett National Park</p>
        </div>
        <div class="rounded-xl bg-white p-6 text-center shadow-card">
          <p class="font-display text-4xl font-bold text-cfr-green-accent">100%</p>
          <p class="mt-2 text-sm text-earth-600">Personalized Hospitality</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cfr-green-dark py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">{siteData.site.tagline}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-white">
        Experience personalized hospitality where the wild meets comfort. Book your stay and discover the difference that boutique hospitality can make.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-lg bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !px-10 !py-4">
          View Accommodation
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-cfr-green-accent px-6 py-3 text-sm font-semibold text-cfr-green-accent transition-all duration-300 hover:bg-cfr-green-accent hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !border-sand-500 !px-10 !py-4 !text-sand-200 hover:!bg-sand-500/20">
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>
