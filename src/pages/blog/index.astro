---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import siteData from "../../data/site.json";

const posts = await getCollection("blog");
const sorted = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<MainLayout title="Blogs" description="Read stories from Corbett Foothills Retreat — wildlife conservation, bird-watching guides, Kumaoni cuisine, safari tips, and life at the edge of the jungle.">
  <Fragment slot="header">
    <Header />
  </Fragment>

  <section class="relative flex min-h-[40vh] items-end overflow-hidden bg-cfr-green-dark pt-24">
    <div class="absolute inset-0 bg-hero-pattern"></div>
    <div class="absolute inset-0 bg-leaf-pattern opacity-30"></div>
    <div class="relative mx-auto w-full max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 lg:pb-16">
      <div class="max-w-3xl">
        <a href="/" class="inline-flex items-center gap-1 text-xs uppercase tracking-widest text-sand-300 hover:text-white transition-colors mb-4">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Back to Home
        </a>
        <h1 class="font-display text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
          Blogs
        </h1>
        <p class="mt-4 max-w-xl text-lg text-white">
          Stories from the edge of the jungle — wildlife encounters, conservation insights, culinary journeys, and the rhythms of life at Corbett Foothills Retreat.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-cream-dark py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {sorted.map((post) => {
          const slug = post.slug;
          const { title, description, pubDate, author, image, tags } = post.data;
          return (
            <a
              href={`/blog/${slug}`}
              class="group flex flex-col overflow-hidden rounded-2xl bg-white shadow-card transition-all duration-300 hover:shadow-glow hover:-translate-y-1"
            >
              {image && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img
                    src={image}
                    alt={title}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                {tags.length > 0 && (
                  <div class="mb-3 flex flex-wrap gap-2">
                    {tags.slice(0, 3).map((tag) => (
                      <span class="rounded-full bg-cfr-green-accent/10 px-3 py-1 text-xs font-medium text-cfr-green-accent">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
                <h2 class="font-display text-xl font-bold text-cfr-green-dark group-hover:text-cfr-green-accent transition-colors">
                  {title}
                </h2>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-earth-600">
                  {description}
                </p>
                <div class="mt-4 flex items-center justify-between border-t border-earth-100 pt-4 text-xs text-earth-500">
                  <span>{author}</span>
                  <time datetime={pubDate.toISOString()}>
                    {pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                  </time>
                </div>
              </div>
            </a>
          );
        })}
      </div>

      {sorted.length === 0 && (
        <div class="py-20 text-center">
          <p class="text-lg text-earth-600">No blog posts published yet. Check back soon.</p>
        </div>
      )}
    </div>
  </section>

  <section class="bg-cfr-green-dark py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">Experience the Stories Firsthand</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-white">
        Every story on this blog begins with a stay at Corbett Foothills Retreat. Book your own adventure and create memories that will last a lifetime.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/accommodation" class="inline-flex items-center justify-center gap-2 rounded-lg bg-cfr-green-accent px-6 py-3 text-sm font-semibold text-white shadow-md transition-all duration-300 hover:bg-cfr-green-dark hover:shadow-lg hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !px-10 !py-4">
          Book Your Stay
        </a>
        <a href="/contact" class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-cfr-green-accent px-6 py-3 text-sm font-semibold text-cfr-green-accent transition-all duration-300 hover:bg-cfr-green-accent hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-green-accent focus-visible:ring-offset-2 !rounded-full !border-sand-500 !px-10 !py-4 !text-sand-200 hover:!bg-sand-500/20">
          Get in Touch
        </a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <Footer />
  </Fragment>
</MainLayout>
