---

<div id="payment-method-selection">
  <div class="rounded-2xl border border-cfr-earth-100 bg-white p-6 text-center shadow-card">
    <h2 class="font-display text-xl font-bold text-cfr-green-dark">Complete Payment</h2>
    <p class="mt-2 text-sm text-cfr-earth-500">
      Your booking will be confirmed after successful payment via Razorpay
    </p>

    <div class="mt-6 space-y-4 text-left">
      <div class="rounded-xl border border-cfr-earth-100 bg-cfr-cream p-4">
        <div class="flex items-center gap-3">
          <svg class="h-6 w-6 text-cfr-green-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
          <div>
            <p class="font-semibold text-cfr-earth-700">Secure Payment via Razorpay</p>
            <p class="text-sm text-cfr-earth-500">
              Pay with UPI, credit/debit card, net banking, or wallet
            </p>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-center gap-4 text-[13px] text-cfr-earth-400">
        <span class="flex items-center gap-1">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Encrypted
        </span>
        <span class="flex items-center gap-1">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Secure
        </span>
        <span class="flex items-center gap-1">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          PCI Compliant
        </span>
      </div>
    </div>
  </div>
</div>
