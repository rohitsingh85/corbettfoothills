---
---

<div class="space-y-8">
  <!-- Booking Details Review -->
  <div class="rounded-2xl border border-cfr-earth-100 bg-white p-6 text-center shadow-card">
    <h2 class="font-display text-lg font-bold text-cfr-green-dark">Review Your Booking</h2>

    <div class="mt-4 space-y-4">
      <!-- Room Info -->
      <div class="flex items-start gap-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-cfr-green-accent/10">
          <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3H21m-3.75 3H21" />
          </svg>
        </div>
        <div>
          <h3 id="review-room-name" class="font-semibold text-cfr-earth-700">Room</h3>
          <p id="review-stay-info" class="mt-1 text-sm text-cfr-earth-500"></p>
        </div>
      </div>

      <!-- Guests Info -->
      <div class="flex items-start gap-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-cfr-green-accent/10">
          <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-cfr-earth-700">Guests</h3>
          <p id="review-guests-info" class="mt-1 text-sm text-cfr-earth-500"></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Guest Details Review -->
  <div id="review-guest-card" class="hidden rounded-2xl border border-cfr-earth-100 bg-white p-6 shadow-card">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-lg font-bold text-cfr-green-dark">Guest Details</h2>
      <button
        type="button"
        data-action="back-to-guests"
        class="text-sm font-medium text-cfr-green-accent hover:underline"
      >
        Edit
      </button>
    </div>

    <div class="mt-4 space-y-3">
      <div class="flex items-start gap-4">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-cfr-green-accent/10">
          <svg class="h-5 w-5 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
        </div>
        <div>
          <p id="review-guest-name" class="font-semibold text-cfr-earth-700"></p>
          <p id="review-guest-email" class="mt-1 text-sm text-cfr-earth-500"></p>
          <p id="review-guest-phone" class="text-sm text-cfr-earth-500"></p>
          <p id="review-guest-country" class="text-sm text-cfr-earth-500"></p>
          <p id="review-guest-special" class="mt-2 hidden text-sm text-cfr-earth-500">
            <span class="font-medium">Special Requests:</span>
            <span id="review-guest-special-text"></span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Pricing Summary -->
  <div class="rounded-2xl border border-cfr-earth-100 bg-white p-6 text-center shadow-card">
    <h2 class="font-display text-lg font-bold text-cfr-green-dark">Pricing Summary</h2>
    <div id="review-pricing" class="mt-4 space-y-3"></div>
  </div>

  <!-- Cancellation Policy -->
  <div id="review-cancellation" class="hidden rounded-2xl border border-cfr-earth-100 bg-white p-6 text-center shadow-card">
    <h2 class="font-display text-lg font-bold text-cfr-green-dark">Cancellation Policy</h2>

    <div class="mt-4 flex items-start gap-3">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-cfr-green-leaf" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div>
        <p id="review-cancellation-policy" class="text-sm text-cfr-earth-600"></p>
        <p id="review-cancellation-expiry" class="mt-2 text-[13px] text-cfr-earth-400"></p>
      </div>
    </div>
  </div>

  <!-- Confirmation Checkbox -->
  <div class="rounded-2xl border border-cfr-earth-100 bg-white p-6 text-center shadow-card">
    <label class="flex cursor-pointer items-start justify-center gap-3">
      <input
        type="checkbox"
        id="booking-confirmation"
        class="mt-1 h-5 w-5 rounded border-cfr-earth-300 text-cfr-green-accent focus:ring-cfr-green-accent"
        required
        aria-describedby="booking-confirmation-desc"
      />
      <div>
        <p class="text-sm font-medium text-cfr-earth-700">
          I confirm the details above are correct and agree to the <a href="/terms-of-service" target="_blank" rel="noopener noreferrer" class="text-cfr-green-accent underline hover:text-cfr-green-dark">booking terms</a>
        </p>
        <p id="booking-confirmation-desc" class="mt-1 text-[13px] text-cfr-earth-500">
          By completing this booking, you agree to our <a href="/terms-of-service" target="_blank" rel="noopener noreferrer" class="text-cfr-green-accent underline hover:text-cfr-green-dark">terms of service</a> and <a href="/terms-of-service" target="_blank" rel="noopener noreferrer" class="text-cfr-green-accent underline hover:text-cfr-green-dark">cancellation policy</a>.
          Payment will be processed securely via Razorpay.
        </p>
      </div>
    </label>
    <p id="confirmation-error" class="mt-2 hidden text-[13px] text-red-600" role="alert"></p>
  </div>

  <!-- Proceed to Payment -->
  <div class="rounded-2xl border border-cfr-earth-100 bg-cfr-cream p-6 text-center">
    <h3 class="font-display text-base font-semibold text-cfr-green-dark">Ready to Confirm?</h3>
    <p class="mt-2 text-sm text-cfr-earth-600">
      Click "Complete Booking" below to proceed to secure payment via Razorpay.
      Your room will be reserved for 5 minutes while you complete payment.
    </p>
    <div class="mt-4 flex items-center justify-center gap-4 text-[13px] text-cfr-earth-400">
      <span class="flex items-center gap-1">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
        </svg>
        Encrypted
      </span>
      <span class="flex items-center gap-1">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Secure
      </span>
      <span class="flex items-center gap-1">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        PCI Compliant
      </span>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const checkbox = document.getElementById('booking-confirmation') as HTMLInputElement;
    const error = document.getElementById('confirmation-error') as HTMLElement;
    const completeBtn = document.getElementById('complete-booking-btn') as HTMLButtonElement;
    const mobileCompleteBtn = document.getElementById('mobile-complete-booking-btn') as HTMLButtonElement;

    function updateButtonState() {
      const isChecked = checkbox?.checked;
      if (completeBtn) {
        completeBtn.disabled = !isChecked;
      }
      if (mobileCompleteBtn) {
        mobileCompleteBtn.disabled = !isChecked;
      }
      if (error) {
        if (isChecked) {
          error.classList.add('hidden');
        }
      }
    }

    if (checkbox) {
      checkbox.addEventListener('change', updateButtonState);
    }

    // Expose confirmation check function globally
    (window as any).validateBookingConfirmation = () => {
      if (!checkbox?.checked) {
        if (error) {
          error.textContent = 'Please confirm the details are correct';
          error.classList.remove('hidden');
        }
        return false;
      }
      return true;
    };
  });
</script>
