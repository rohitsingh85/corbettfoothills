---
---

<div id="pay-at-checkin" class="hidden">
  <div class="rounded-2xl border border-cfr-earth-100 bg-white p-6 text-center shadow-card">
    <div class="flex flex-col items-center">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-cfr-green-accent/10">
        <svg class="h-6 w-6 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
        </svg>
      </div>
      <h2 class="mt-4 font-display text-xl font-bold text-cfr-green-dark">Pay at Check-in</h2>
      <p class="mt-2 max-w-md text-sm text-cfr-earth-600">
        Your reservation will be confirmed after submitting this form. No online payment is required — you can pay when you arrive at Corbett Foothills Retreat.
      </p>
    </div>

    <div class="mt-6 space-y-4">
      <div class="rounded-xl bg-cfr-cream p-4">
        <h3 class="text-sm font-semibold text-cfr-earth-700">Accepted payment methods at check-in</h3>
        <div class="mt-3 grid grid-cols-2 gap-3 text-left">
          <div class="flex items-center gap-2 text-sm text-cfr-earth-600">
            <svg class="h-4 w-4 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
            </svg>
            <span>Cash</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-cfr-earth-600">
            <svg class="h-4 w-4 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
            </svg>
            <span>Debit / Credit Card</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-cfr-earth-600">
            <svg class="h-4 w-4 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
            </svg>
            <span>UPI</span>
          </div>
          <div class="flex items-center gap-2 text-sm text-cfr-earth-600">
            <svg class="h-4 w-4 text-cfr-green-accent" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
            </svg>
            <span>Bank Transfer</span>
          </div>
        </div>
      </div>

      <div class="flex items-start justify-center gap-3 text-sm text-cfr-earth-600">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-cfr-green-leaf" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="text-center">
          <p class="font-medium text-cfr-earth-700">No online payment required</p>
          <p class="mt-1 text-sm text-cfr-earth-500">
            Your reservation will be held until check-in. If you need to cancel, please do so at least 48 hours before your arrival date.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
