---
interface Props {
  expiresAt?: number;
  sessionId?: string;
}

const { expiresAt, sessionId } = Astro.props;
---

<div
  id="session-countdown"
  class="session-countdown hidden"
  role="timer"
  aria-live="polite"
  aria-atomic="true"
  aria-label="Time remaining to complete your booking"
  data-expires-at={expiresAt || ""}
  data-session-id={sessionId || ""}
>
  <div class="countdown-inner rounded-xl border border-cfr-earth-100 bg-white p-4 shadow-card">
    <div class="flex items-center gap-3">
      <div class="countdown-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cfr-green-accent/10">
        <svg class="h-5 w-5 text-cfr-green-accent countdown-icon-svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium text-cfr-earth-700">
          Your room is reserved for <span id="countdown-time" class="font-bold tabular-nums">5:00</span>
        </p>
        <p class="countdown-subtext text-[13px] text-cfr-earth-400">Complete payment to confirm your booking</p>
      </div>
    </div>
    <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-cfr-earth-100">
      <div
        id="countdown-progress"
        class="countdown-progress h-full rounded-full bg-cfr-green-accent transition-all duration-1000 ease-linear"
        style="width: 100%"
      ></div>
    </div>
  </div>
  <div id="countdown-sr-announce" class="sr-only" aria-live="assertive" aria-atomic="true"></div>
</div>

<style>
  .session-countdown {
    animation: countdownFadeIn 0.3s ease-out forwards;
  }

  @keyframes countdownFadeIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .countdown-state-warning .countdown-icon {
    background-color: rgba(194, 156, 62, 0.1);
  }
  .countdown-state-warning .countdown-icon-svg {
    color: #c29c3e;
  }
  .countdown-state-warning .countdown-progress {
    background-color: #c29c3e;
  }

  .countdown-state-urgent .countdown-icon {
    background-color: rgba(220, 80, 60, 0.1);
  }
  .countdown-state-urgent .countdown-icon-svg {
    color: #dc503c;
  }
  .countdown-state-urgent .countdown-progress {
    background-color: #dc503c;
  }
  .countdown-state-urgent .countdown-inner {
    border-color: rgba(220, 80, 60, 0.2);
  }

  .countdown-state-urgent #countdown-time {
    animation: countdownPulse 1s ease-in-out infinite;
  }

  @keyframes countdownPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
  }

  @media (prefers-reduced-motion: reduce) {
    .session-countdown {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .countdown-state-urgent #countdown-time {
      animation: none;
    }
    .countdown-progress {
      transition: none;
    }
  }
</style>
