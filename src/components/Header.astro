---
import siteData from "../data/site.json";

export interface Props {
  variant?: "transparent" | "solid";
}

const { variant = "solid" } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class={`fixed top-0 z-50 w-full transition-all duration-300 ${variant === "solid" ? "bg-cfr-green-dark shadow-lg" : ""}`}
  data-header
  data-variant={variant}
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8"
  >
    <a
      href="/"
      class="flex items-center"
    >
      <img
        src="/logos/CFR_logo_white_v2.png"
        alt="Corbett Foothills Retreat"
        width="1280"
        height="1024"
        class="h-24 w-auto sm:h-32 md:h-40 lg:h-48"
        loading="eager"
      />
    </a>

    <div class="flex flex-1 items-center justify-end gap-6">
      <ul class="hidden items-center gap-1 lg:flex">
        {
          siteData.nav.map((item) => {
            const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class={`rounded-lg px-3 py-2 text-sm font-medium transition-all duration-200 ${
                    isActive
                      ? "text-cfr-sand-200 bg-cfr-green-accent/20"
                      : "text-cfr-sand-300 hover:text-cfr-sand-100 hover:bg-white/5"
                  }`}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="flex items-center gap-3">
      <a href="/booking/" class="inline-flex items-center justify-center gap-2 rounded-full bg-cfr-sand-500 px-5 py-2 text-xs font-semibold uppercase tracking-wider text-cfr-earth-700 transition-all duration-300 hover:bg-cfr-sand-400 hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-sand-400 focus-visible:ring-offset-2">
        Book Now
      </a>
      <button
        id="menu-toggle"
        class="relative z-50 flex h-10 w-10 items-center justify-center rounded-lg text-cfr-sand-200 lg:hidden"
        aria-label="Toggle navigation menu"
        type="button"
      >
        <svg id="menu-open-icon" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="menu-close-icon" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    </div>
  </nav>

  <!-- Mobile menu overlay -->
  <div
    id="mobile-menu"
    class="invisible fixed inset-0 z-40 flex flex-col items-center justify-center bg-cfr-green-dark/98 backdrop-blur-xl opacity-0 transition-all duration-500"
  >
    <ul class="flex w-full max-w-xs flex-col items-stretch gap-3">
      {
        siteData.nav.map((item, i) => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
          <li
            class="w-full mobile-nav-item translate-y-4 opacity-0 transition-all duration-500"
            style={`transition-delay: ${i * 80}ms`}
          >
            <a
              href={item.href}
              class={`block w-full rounded-xl px-6 py-4 text-center text-base font-semibold transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-sand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cfr-green-dark ${
                isActive
                  ? "bg-cfr-green-accent text-cfr-sand-200 border border-cfr-sand-500/30"
                  : "bg-cfr-green text-white border border-white/10 hover:bg-cfr-green-accent hover:border-white/20"
              }`}
            >
              {item.label}
            </a>
          </li>
          );
        })
      }
      <li class="w-full mobile-nav-item translate-y-4 opacity-0 transition-all duration-500" style="transition-delay: 800ms">
        <a href="/booking/" class="flex w-full items-center justify-center rounded-xl bg-cfr-sand-500 px-6 py-4 text-center text-base font-bold uppercase tracking-wider text-cfr-earth-700 transition-all duration-300 hover:bg-cfr-sand-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-cfr-sand-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cfr-green-dark">
          Book Now
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.querySelector("[data-header]");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.getElementById("menu-open-icon");
  const closeIcon = document.getElementById("menu-close-icon");
  const navItems = document.querySelectorAll(".mobile-nav-item");
  let isOpen = false;

  // Header scroll effect
  const variant = header.dataset.variant;
  if (variant === "transparent") {
    let lastScroll = 0;
    window.addEventListener("scroll", () => {
      const y = window.scrollY;
      if (y > 60) {
        header.classList.add("bg-cfr-green-dark/95", "shadow-lg", "backdrop-blur-md");
        header.classList.remove("bg-transparent");
      } else {
        header.classList.remove("bg-cfr-green-dark/95", "shadow-lg", "backdrop-blur-md");
        header.classList.add("bg-transparent");
      }
      lastScroll = y;
    });
  }

  // Mobile menu toggle
  toggle.addEventListener("click", () => {
    isOpen = !isOpen;
    if (isOpen) {
      menu.classList.remove("invisible", "opacity-0");
      menu.classList.add("opacity-100");
      document.body.style.overflow = "hidden";
      openIcon.classList.add("hidden");
      closeIcon.classList.remove("hidden");
      navItems.forEach((item) => {
        item.classList.remove("translate-y-4", "opacity-0");
      });
    } else {
      menu.classList.add("opacity-0");
      menu.classList.remove("opacity-100");
      document.body.style.overflow = "";
      openIcon.classList.remove("hidden");
      closeIcon.classList.add("hidden");
      navItems.forEach((item) => {
        item.classList.add("translate-y-4", "opacity-0");
      });
      setTimeout(() => {
        menu.classList.add("invisible");
      }, 500);
    }
  });

  // Close on link click
  document.querySelectorAll("#mobile-menu a").forEach((link) => {
    link.addEventListener("click", () => {
      if (isOpen) toggle.click();
    });
  });
</script>
