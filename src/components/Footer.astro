---
import siteData from "../data/site.json";
---

<footer class="relative overflow-hidden bg-cfr-green-dark">
  <!-- Decorative top border -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-cfr-green-accent via-cfr-sand-500 to-cfr-green-leaf"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center">
      <img
          src="/logos/CFR_logo_white_v2.png"
          alt="Corbett Foothills Retreat"
          width="1280"
          height="1024"
          class="h-16 w-auto"
          loading="lazy"
        />
        </a>
        <p class="mt-4 text-sm leading-relaxed text-white">
          {siteData.site.description}
        </p>
        <div class="mt-6 flex gap-4">
          <a
            href={siteData.site.social.instagram}
            class="flex h-10 w-10 items-center justify-center rounded-full bg-white/5 text-white/60 transition-colors hover:bg-cfr-green-accent hover:text-white"
            aria-label="Instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 016.11 2.525c.636-.247 1.363-.416 2.427-.465C8.83 2.013 9.942 2 12.315 2zm0 1.802c-2.373 0-2.7.01-3.656.053-1.023.047-1.58.218-1.95.362-.49.19-.84.416-1.207.783-.367.367-.593.717-.783 1.207-.144.37-.315.927-.362 1.95-.043.957-.053 1.283-.053 3.656 0 2.373.01 2.7.053 3.656.047 1.023.218 1.58.362 1.95.19.49.416.84.783 1.207.367.367.717.593 1.207.783.37.144.927.315 1.95.362.957.043 1.283.053 3.656.053 2.373 0 2.7-.01 3.656-.053 1.023-.047 1.58-.218 1.95-.362.49-.19.84-.416 1.207-.783.367-.367.593-.717.783-1.207.144-.37.315-.927.362-1.95.043-.957.053-1.283.053-3.656 0-2.373-.01-2.7-.053-3.656-.047-1.023-.218-1.58-.362-1.95-.19-.49-.416-.84-.783-1.207-.367-.367-.717-.593-1.207-.783-.37-.144-.927-.315-1.95-.362-.957-.043-1.283-.053-3.656-.053zm0 4.811a4.387 4.387 0 100 8.774 4.387 4.387 0 000-8.774zm0 1.802a2.585 2.585 0 110 5.17 2.585 2.585 0 010-5.17zm5.068-2.259a1.025 1.025 0 100 2.05 1.025 1.025 0 000-2.05z"/></svg>
          </a>
          <a
            href={siteData.site.social.facebook}
            class="flex h-10 w-10 items-center justify-center rounded-full bg-white/5 text-white/60 transition-colors hover:bg-cfr-green-accent hover:text-white"
            aria-label="Facebook"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a
            href={siteData.site.social.youtube}
            class="flex h-10 w-10 items-center justify-center rounded-full bg-white/5 text-white/60 transition-colors hover:bg-cfr-green-accent hover:text-white"
            aria-label="YouTube"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-cfr-sand-300">Explore</h3>
        <ul class="mt-4 space-y-3">
          {
            siteData.nav.map((item) => (
              <li><a href={item.href} class="text-sm text-cfr-sand-300 transition-colors hover:text-white">{item.label}</a></li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-cfr-sand-300">Contact</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href={`tel:${siteData.site.phone}`} class="text-sm text-cfr-sand-300 transition-colors hover:text-white">
              {siteData.site.phone}
            </a>
          </li>
          <li>
            <a href={`mailto:${siteData.site.email}`} class="text-sm text-cfr-sand-300 transition-colors hover:text-white">
              {siteData.site.email}
            </a>
          </li>
          <li class="text-sm text-white/70">
            {siteData.site.location}
          </li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="font-display text-sm font-semibold uppercase tracking-widest text-cfr-sand-300">Stay Connected</h3>
        <p class="mt-4 text-sm text-white">Get exclusive offers and wildlife stories.</p>
        <form id="newsletter-form" class="mt-4 space-y-4">
          <input type="text" name="website" class="hidden" tabindex="-1" autocomplete="off" />
          <!-- Phone row -->
          <div class="flex gap-2">
            <input
              type="tel"
              name="phone"
              placeholder="Your number"
              class="min-w-0 flex-1 rounded-lg border-0 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-cfr-sand-300 focus:outline-none focus:ring-2 focus:ring-cfr-green-accent"
            />
            <button type="submit" data-field="phone" class="rounded-lg bg-cfr-green-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-cfr-green-leaf">
              Join
            </button>
          </div>
          <!-- OR divider -->
          <div class="flex items-center gap-3">
            <span class="h-px flex-1 bg-white/10"></span>
            <span class="text-xs font-semibold uppercase tracking-widest text-cfr-sand-300">OR</span>
            <span class="h-px flex-1 bg-white/10"></span>
          </div>
          <!-- Email row -->
          <div class="flex gap-2">
            <input
              type="email"
              name="email"
              placeholder="Your email"
              class="min-w-0 flex-1 rounded-lg border-0 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-cfr-sand-300 focus:outline-none focus:ring-2 focus:ring-cfr-green-accent"
            />
            <button type="submit" data-field="email" class="rounded-lg bg-cfr-green-accent px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-cfr-green-leaf">
              Join
            </button>
          </div>
        </form>
        <p id="newsletter-msg" class="mt-2 text-xs text-cfr-sand-300 hidden"></p>
        <script>
          function getSubmitted() {
            try { return JSON.parse(localStorage.getItem("cfr_submitted") || "[]"); } catch { return []; }
          }
          function markSubmitted(val) {
            const list = getSubmitted();
            list.push({ val, t: Date.now() });
            localStorage.setItem("cfr_submitted", JSON.stringify(list.slice(-50)));
          }
          function isDuplicate(val) {
            const cutoff = Date.now() - 86400000;
            return getSubmitted().some((e) => e.val === val && e.t > cutoff);
          }
          function lastSubmitted() {
            const list = getSubmitted();
            return list.length ? list[list.length - 1].t : 0;
          }
          document.getElementById("newsletter-form")?.addEventListener("submit", async (e) => {
            e.preventDefault();
            const form = e.currentTarget;
            const btn = e.submitter;
            const msg = document.getElementById("newsletter-msg");
            const email = form.querySelector('[name="email"]').value.trim();
            const phone = form.querySelector('[name="phone"]').value.trim();
            const field = btn.getAttribute("data-field");
            if (field === "email" && !email) return;
            if (field === "phone" && !phone) return;
            if (field === "phone") {
              if (!/^[1-9]\d{9}$/.test(phone)) {
                msg.textContent = "Enter a valid 10-digit number";
                msg.className = "mt-2 text-xs text-red-300";
                msg.classList.remove("hidden");
                return;
              }
              if (isDuplicate(phone)) {
                msg.textContent = "This number was already submitted";
                msg.className = "mt-2 text-xs text-red-300";
                msg.classList.remove("hidden");
                return;
              }
            }
            if (field === "email") {
              if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                msg.textContent = "Enter a valid email address";
                msg.className = "mt-2 text-xs text-red-300";
                msg.classList.remove("hidden");
                return;
              }
              if (isDuplicate(email)) {
                msg.textContent = "This email was already submitted";
                msg.className = "mt-2 text-xs text-red-300";
                msg.classList.remove("hidden");
                return;
              }
            }
            const cooldown = Date.now() - lastSubmitted();
            if (cooldown < 30000 && cooldown > 0) {
              msg.textContent = "Please wait before submitting again";
              msg.className = "mt-2 text-xs text-red-300";
              msg.classList.remove("hidden");
              return;
            }
            const payload = { website: form.querySelector('[name="website"]').value };
            if (email) payload.email = email;
            if (phone) payload.phone = phone;
            btn.textContent = "Subscribing…";
            btn.disabled = true;
            msg.classList.add("hidden");
            try {
              const res = await fetch("/newsletter", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
              });
              const json = await res.json();
              if (json.success) {
                msg.textContent = "Thank. We'll be in touch.";
                msg.className = "mt-2 text-xs text-green-300";
                markSubmitted(email || phone);
                form.reset();
                form.querySelectorAll("input[type='email'], input[type='tel']").forEach((el) => (el.value = ""));
              } else {
                msg.textContent = json.error || "Something went wrong.";
                msg.className = "mt-2 text-xs text-red-300";
              }
            } catch {
              msg.textContent = "Network error. Please try again.";
              msg.className = "mt-2 text-xs text-red-300";
            }
            msg.classList.remove("hidden");
            btn.textContent = "Join";
            btn.disabled = false;
          });
        </script>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 border-t border-white/10 pt-8 flex flex-col items-center justify-between gap-4 sm:flex-row">
      <p class="text-xs text-cfr-sand-300">
        &copy; {new Date().getFullYear()} Corbett Foothills Retreat. All rights reserved.
      </p>
      <div class="flex gap-6">
        <a href="#" class="text-xs text-cfr-sand-300 transition-colors hover:text-white">Privacy Policy</a>
        <a href="#" class="text-xs text-cfr-sand-300 transition-colors hover:text-white">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
